{{ 'evora-base.css' | asset_url | stylesheet_tag }}
{{ 'evora-components.css' | asset_url | stylesheet_tag }}

<section
  id="EvoraHero-{{ section.id }}"
  class="evora-hero"
  data-section-id="{{ section.id }}"
>
  <div class="evora-container">
    <div class="evora-hero__grid">
      <!-- Left Column: Hero Content & Call to Actions -->
      <div class="evora-hero__content">
        {%- if section.settings.pill_badge != blank -%}
          <div class="evora-pill" style="margin-bottom: 1.2rem;">
            {{ section.settings.pill_badge }}
          </div>
        {%- endif -%}

        <h1 class="evora-hero__title">
          {%- if section.settings.heading != blank -%}
            {{ section.settings.heading }}
          {%- else -%}
            Your Daily <span class="evora-highlight">Wellness</span>, All in One
          {%- endif -%}
        </h1>

        <div class="evora-hero__subtitle">
          {%- if section.settings.subheading != blank -%}
            {{ section.settings.subheading }}
          {%- else -%}
            <p>Track your cycle, mood, and health to feel your best every day.</p>
          {%- endif -%}
        </div>

        <div class="evora-hero__actions">
          {%- if section.settings.primary_button_label != blank -%}
            <a
              href="{{ section.settings.primary_button_link | default: '/collections/all' }}"
              class="evora-btn evora-btn--primary evora-btn--lg"
            >
              {{ section.settings.primary_button_label }}
            </a>
          {%- endif -%}
        </div>

        <!-- Social Proof Avatars -->
        {%- if section.settings.show_social_proof -%}
          <div class="evora-social-proof">
            <div class="evora-avatar-stack">
              <img src="https://images.unsplash.com/photo-1534528741775-53994a69daeb?w=100&h=100&fit=crop&crop=face" alt="User" loading="lazy" width="38" height="38">
              <img src="https://images.unsplash.com/photo-1517841905240-472988babdf9?w=100&h=100&fit=crop&crop=face" alt="User" loading="lazy" width="38" height="38">
              <img src="https://images.unsplash.com/photo-1544005313-94ddf0286df2?w=100&h=100&fit=crop&crop=face" alt="User" loading="lazy" width="38" height="38">
            </div>
            <span class="evora-social-proof__text">
              {{ section.settings.social_proof_text | default: 'Join 50,000+ women on their wellness journey' }}
            </span>
          </div>
        {%- endif -%}
      </div>

      <!-- Right Column: Interactive Phone Mockup -->
      <div class="evora-phone-wrapper">
        <div class="evora-phone-mockup">
          <!-- Status bar -->
          <div class="evora-phone__statusbar">
            <span>6:29</span>
            <div style="display: flex; gap: 4px; align-items: center;">
              <span>📶</span>
              <span>🔋</span>
            </div>
          </div>

          <!-- App Screen Body -->
          <div class="evora-phone__body">
            <!-- Header -->
            <div class="evora-phone__header">
              <div>
                <div class="evora-phone__greeting">Good evening, Sarah! 🌸</div>
                <div class="evora-phone__subgreeting">Let's make today a healthy, happy you.</div>
              </div>
              <div style="font-size: 1.6rem; color: #FF5B82;">🔔</div>
            </div>

            <!-- Score Card -->
            <div class="evora-app-score-card">
              <div class="evora-app-score__circle">
                <span class="evora-app-score__num">82</span>
                <span class="evora-app-score__label">Excellent</span>
              </div>
              <div class="evora-app-score__quote">
                "You are enough, just as you are." ✨
              </div>
            </div>

            <!-- Cycle Status Tag -->
            <div style="display: flex; align-items: center; justify-content: space-between; background: #FFF6F8; padding: 0.8rem 1.2rem; border-radius: 12px; font-size: 1.15rem; font-weight: 700; color: var(--evora-text);">
              <span>Cycle Day ••• Normal Day</span>
              <span style="color: #FF5B82;">●</span>
            </div>

            <!-- Daily Wellness Tip -->
            <div class="evora-app-mini-card">
              <div class="evora-app-mini-card__tag">🌸 Daily Wellness Tip</div>
              <div class="evora-app-mini-card__title">Today's Normal Day Insight 🌸</div>
              <div class="evora-app-mini-card__desc">Your cycle looks normal for today. Keep hydrated!</div>
            </div>

            <!-- Log Symptoms Card -->
            <div class="evora-app-mini-card">
              <div class="evora-app-mini-card__title">Log Your Symptoms</div>
              <div class="evora-app-mini-card__desc">Track your condition & get personalized guidance.</div>
            </div>

            <!-- Navigation Bar -->
            <div class="evora-phone__nav">
              <span class="evora-phone__nav-item--active">🏠</span>
              <span>📅</span>
              <span style="background: #FF5B82; color: #fff; width: 26px; height: 26px; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 1.1rem;">+</span>
              <span>📊</span>
              <span>👤</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Evora Hero Banner",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "pill_badge",
      "label": "Top Pill Badge",
      "default": "#1 Women's Wellness Companion"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "default": "Your Daily Wellness, All in One"
    },
    {
      "type": "richtext",
      "id": "subheading",
      "label": "Subheading",
      "default": "<p>Track your cycle, mood, and health to feel your best every day.</p>"
    },
    {
      "type": "text",
      "id": "primary_button_label",
      "label": "Button Label",
      "default": "Explore The App"
    },
    {
      "type": "url",
      "id": "primary_button_link",
      "label": "Button Link"
    },
    {
      "type": "checkbox",
      "id": "show_social_proof",
      "label": "Show Social Proof Stack",
      "default": true
    },
    {
      "type": "text",
      "id": "social_proof_text",
      "label": "Social Proof Text",
      "default": "Join 50,000+ women on their wellness journey"
    }
  ],
  "presets": [
    {
      "name": "Evora Hero Banner"
    }
  ]
}
{% endschema %}
