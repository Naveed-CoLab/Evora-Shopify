{{ 'evora-base.css' | asset_url | stylesheet_tag }}
{{ 'evora-components.css' | asset_url | stylesheet_tag }}

<section
  id="EvoraTrustBar-{{ section.id }}"
  class="evora-section-padding evora-bg-surface"
  data-section-id="{{ section.id }}"
>
  <div class="evora-container">
    <div class="evora-trust-row">
      {%- for block in section.blocks -%}
        <div class="evora-trust-item" {{ block.shopify_attributes }}>
          <div class="evora-trust-item__icon">
            {%- case block.settings.icon -%}
              {%- when 'clock' -%}⏰
              {%- when 'sleep' -%}🛏️
              {%- when 'science' -%}🔬
              {%- when 'heart' -%}💖
              {%- else -%}✨
            {%- endcase -%}
          </div>
          <div>
            <div class="evora-trust-item__title">{{ block.settings.title }}</div>
            <div class="evora-trust-item__desc">{{ block.settings.description }}</div>
          </div>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Evora Trust Bar",
  "tag": "section",
  "class": "section",
  "blocks": [
    {
      "type": "trust_item",
      "name": "Trust Item",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "clock", "label": "Clock" },
            { "value": "sleep", "label": "Sleep / Bed" },
            { "value": "science", "label": "Science / Shield" },
            { "value": "heart", "label": "Heart" }
          ],
          "default": "clock"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "No snooze"
        },
        {
          "type": "text",
          "id": "description",
          "label": "Description",
          "default": "The only way to turn it off is to get up."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Evora Trust Bar",
      "blocks": [
        {
          "type": "trust_item",
          "settings": {
            "icon": "clock",
            "title": "No snooze",
            "description": "The only way to turn it off is to get up."
          }
        },
        {
          "type": "trust_item",
          "settings": {
            "icon": "sleep",
            "title": "Better sleep",
            "description": "Builds healthier habits and better mornings."
          }
        },
        {
          "type": "trust_item",
          "settings": {
            "icon": "science",
            "title": "Science-backed",
            "description": "Designed with sleep experts and backed by science."
          }
        },
        {
          "type": "trust_item",
          "settings": {
            "icon": "heart",
            "title": "Loved by users",
            "description": "Thousands of 5-star reviews from real customers."
          }
        }
      ]
    }
  ]
}
{% endschema %}
