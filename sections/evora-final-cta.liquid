{{ 'evora-base.css' | asset_url | stylesheet_tag }}
{{ 'evora-components.css' | asset_url | stylesheet_tag }}

<section
  id="EvoraFinalCTA-{{ section.id }}"
  class="evora-final-cta evora-section-padding"
  style="background: linear-gradient(135deg, #FBECEE 0%, #F6E6E8 100%); text-align: center; border-top: 1px solid var(--evora-border);"
  data-section-id="{{ section.id }}"
>
  <div class="evora-container evora-container--narrow">
    {%- if section.settings.badge_text != blank -%}
      <div style="display: flex; justify-content: center; margin-bottom: 1.6rem;">
        {% render 'evora-badge',
          text: section.settings.badge_text,
          style: 'primary',
          show_dot: true
        %}
      </div>
    {%- endif -%}

    {%- if section.settings.heading != blank -%}
      <h2 style="font-size: var(--font-size-h1); font-weight: 800; color: var(--evora-text); line-height: 1.15; margin-bottom: 1.6rem;">
        {{ section.settings.heading }}
      </h2>
    {%- endif -%}

    {%- if section.settings.subheading != blank -%}
      <div style="font-size: 1.7rem; color: var(--evora-text-secondary); line-height: 1.6; max-width: 580px; margin: 0 auto 3.2rem auto;">
        {{ section.settings.subheading }}
      </div>
    {%- endif -%}

    <div style="display: flex; align-items: center; justify-content: center; gap: 1.6rem; flex-wrap: wrap;">
      {%- if section.settings.primary_button_label != blank -%}
        {% render 'evora-button',
          label: section.settings.primary_button_label,
          link: section.settings.primary_button_link,
          style: 'primary',
          size: 'lg'
        %}
      {%- endif -%}

      {%- if section.settings.secondary_button_label != blank -%}
        {% render 'evora-button',
          label: section.settings.secondary_button_label,
          link: section.settings.secondary_button_link,
          style: 'secondary',
          size: 'lg'
        %}
      {%- endif -%}
    </div>

    <p style="font-size: 1.3rem; color: var(--evora-muted); margin-top: 2rem;">
      {{ section.settings.guarantee_text | default: '30-Day Happiness Guarantee • Free Shipping on Orders $50+' }}
    </p>
  </div>
</section>

{% schema %}
{
  "name": "Evora Final CTA",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "badge_text",
      "label": "Badge Text",
      "default": "Begin Your Transformation"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Step into your body's natural harmony"
    },
    {
      "type": "richtext",
      "id": "subheading",
      "label": "Subheading",
      "default": "<p>Join thousands of women balancing energy, smoothing cycles, and unlocking daily biological clarity with Evora.</p>"
    },
    {
      "type": "text",
      "id": "primary_button_label",
      "label": "Primary Button Label",
      "default": "Shop Evora Powder"
    },
    {
      "type": "url",
      "id": "primary_button_link",
      "label": "Primary Button Link"
    },
    {
      "type": "text",
      "id": "secondary_button_label",
      "label": "Secondary Button Label",
      "default": "Try Evora+ App"
    },
    {
      "type": "url",
      "id": "secondary_button_link",
      "label": "Secondary Button Link"
    },
    {
      "type": "text",
      "id": "guarantee_text",
      "label": "Guarantee Note",
      "default": "30-Day Happiness Guarantee • Free Shipping on Orders $50+"
    }
  ],
  "presets": [
    {
      "name": "Evora Final CTA"
    }
  ]
}
{% endschema %}
