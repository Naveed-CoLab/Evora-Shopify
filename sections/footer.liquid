{{ 'evora-base.css' | asset_url | stylesheet_tag }}
{{ 'evora-components.css' | asset_url | stylesheet_tag }}

<footer class="evora-dark-footer" id="EvoraFooter-{{ section.id }}">
  <div class="evora-container">
    <div class="evora-footer-grid">
      <!-- Column 1: Brand Info & App Badges -->
      <div>
        <a href="{{ routes.root_url }}" style="display: flex; align-items: center; gap: 0.8rem; text-decoration: none; color: #FFFFFF; font-size: 2.2rem; font-weight: 800;">
          {%- if settings.logo != blank -%}
            {{ settings.logo | image_url: width: 200 | image_tag:
              loading: 'lazy',
              style: 'max-height: 36px; width: auto;'
            }}
          {%- else -%}
            <svg width="28" height="28" viewBox="0 0 28 28" fill="none">
              <rect width="28" height="28" rx="8" fill="#1A181C"/>
              <path d="M7 9H18M7 14H15M7 19H21" stroke="#FF5B82" stroke-width="3" stroke-linecap="round"/>
            </svg>
            <span>{{ section.settings.brand_title | default: 'Flow' }}</span>
          {%- endif -%}
        </a>

        <div class="evora-footer__bio">
          {{ section.settings.bio_text | default: 'The alarm that actually gets you out of bed. No snooze. No shortcuts. Just real wake-ups.' }}
        </div>

        {%- if section.settings.show_app_badges -%}
          <div class="evora-app-badges">
            <a href="{{ section.settings.app_store_url | default: '#' }}" class="evora-app-badge" target="_blank" rel="noopener">
              <span style="font-size: 1.6rem;"></span>
              <div style="text-align: left; line-height: 1.1;">
                <div style="font-size: 0.75rem; color: #9A9598;">Download on the</div>
                <div>App Store</div>
              </div>
            </a>
            <a href="{{ section.settings.play_store_url | default: '#' }}" class="evora-app-badge" target="_blank" rel="noopener">
              <span style="font-size: 1.5rem; color: #2ECC71;">▶</span>
              <div style="text-align: left; line-height: 1.1;">
                <div style="font-size: 0.75rem; color: #9A9598;">GET IT ON</div>
                <div>Google Play</div>
              </div>
            </a>
          </div>
        {%- endif -%}
      </div>

      <!-- Dynamic Blocks: Link Lists & Contact Us -->
      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when 'link_list' -%}
            <div {{ block.shopify_attributes }}>
              <div class="evora-footer__col-title">{{ block.settings.heading | default: block.settings.menu.title }}</div>
              <ul class="evora-footer__links">
                {%- for link in block.settings.menu.links -%}
                  <li>
                    <a href="{{ link.url }}" class="evora-footer__link">{{ link.title }}</a>
                  </li>
                {%- else -%}
                  <!-- Default Fallbacks -->
                  <li><a href="/" class="evora-footer__link">Home</a></li>
                  <li><a href="/collections/all" class="evora-footer__link">Shop</a></li>
                  <li><a href="/pages/about" class="evora-footer__link">About Us</a></li>
                  <li><a href="/pages/faq" class="evora-footer__link">FAQ</a></li>
                  <li><a href="/pages/contact" class="evora-footer__link">Contact Us</a></li>
                {%- endfor -%}
              </ul>
            </div>

          {%- when 'contact' -%}
            <div {{ block.shopify_attributes }}>
              <div class="evora-footer__col-title">{{ block.settings.heading | default: 'Contact Us' }}</div>
              <div style="display: flex; flex-direction: column; gap: 1.4rem;">
                <div>
                  <div class="evora-footer__contact-label">{{ block.settings.contact_label | default: 'Email' }}</div>
                  <a href="mailto:{{ block.settings.email | default: 'support@flowalarmclock.com' }}" class="evora-footer__contact-val">
                    {{ block.settings.email | default: 'support@flowalarmclock.com' }}
                  </a>
                </div>
                {%- if block.settings.extra_text != blank -%}
                  <div style="font-size: 1.35rem; color: #A09BA0;">
                    {{ block.settings.extra_text }}
                  </div>
                {%- endif -%}
              </div>
            </div>
        {%- endcase -%}
      {%- endfor -%}
    </div>

    <!-- Bottom Bar: Copyright & Socials -->
    <div class="evora-footer-bottom">
      <div>
        {{ section.settings.copyright_text | default: '© 2026 Flow. All Rights Reserved' }}
      </div>

      <div class="evora-footer-socials">
        {%- if settings.social_facebook_link != blank or true -%}
          <a href="{{ settings.social_facebook_link | default: '#' }}" aria-label="Facebook">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
          </a>
        {%- endif -%}
        {%- if settings.social_instagram_link != blank or true -%}
          <a href="{{ settings.social_instagram_link | default: '#' }}" aria-label="Instagram">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/></svg>
          </a>
        {%- endif -%}
        {%- if settings.social_tiktok_link != blank or true -%}
          <a href="{{ settings.social_tiktok_link | default: '#' }}" aria-label="TikTok">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M19.59 6.69a4.83 4.83 0 0 1-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 0 1-5.2 1.74 2.89 2.89 0 0 1 2.31-4.64 2.93 2.93 0 0 1 .88.13V9.4a6.84 6.84 0 0 0-1-.05A6.33 6.33 0 0 0 5 20.1a6.34 6.34 0 0 0 10.86-4.43v-7a8.16 8.16 0 0 0 4.77 1.52v-3.4a4.85 4.85 0 0 1-1.04-.1z"/></svg>
          </a>
        {%- endif -%}
      </div>
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Sleek Dark Modern Footer",
  "tag": "footer",
  "class": "section-footer",
  "settings": [
    {
      "type": "text",
      "id": "brand_title",
      "label": "Brand Title",
      "default": "Flow"
    },
    {
      "type": "textarea",
      "id": "bio_text",
      "label": "Bio Description",
      "default": "The alarm that actually gets you out of bed. No snooze. No shortcuts. Just real wake-ups."
    },
    {
      "type": "checkbox",
      "id": "show_app_badges",
      "label": "Show App Store Badges",
      "default": true
    },
    {
      "type": "url",
      "id": "app_store_url",
      "label": "Apple App Store URL"
    },
    {
      "type": "url",
      "id": "play_store_url",
      "label": "Google Play Store URL"
    },
    {
      "type": "text",
      "id": "copyright_text",
      "label": "Copyright Text",
      "default": "© 2026 Flow. All Rights Reserved"
    }
  ],
  "blocks": [
    {
      "type": "link_list",
      "name": "Navigation Menu",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Column Title",
          "default": "Flow"
        },
        {
          "type": "link_list",
          "id": "menu",
          "label": "Select Menu",
          "default": "footer"
        }
      ]
    },
    {
      "type": "contact",
      "name": "Contact Info",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Contact Us"
        },
        {
          "type": "text",
          "id": "contact_label",
          "label": "Sub-label",
          "default": "Email"
        },
        {
          "type": "text",
          "id": "email",
          "label": "Contact Email",
          "default": "support@flowalarmclock.com"
        },
        {
          "type": "text",
          "id": "extra_text",
          "label": "Extra Text"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Sleek Dark Modern Footer",
      "blocks": [
        {
          "type": "link_list",
          "settings": {
            "heading": "Flow"
          }
        },
        {
          "type": "link_list",
          "settings": {
            "heading": "Company"
          }
        },
        {
          "type": "contact",
          "settings": {
            "heading": "Contact Us",
            "contact_label": "Email",
            "email": "support@flowalarmclock.com"
          }
        }
      ]
    }
  ]
}
{% endschema %}
