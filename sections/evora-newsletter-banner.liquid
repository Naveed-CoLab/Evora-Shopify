{{ 'evora-base.css' | asset_url | stylesheet_tag }}
{{ 'evora-components.css' | asset_url | stylesheet_tag }}

<section
  id="EvoraNewsletter-{{ section.id }}"
  class="evora-section-padding evora-bg-surface"
  data-section-id="{{ section.id }}"
>
  <div class="evora-container">
    <div class="evora-newsletter-box">
      <!-- Left Column: Form & Copy -->
      <div>
        <h2 class="evora-serif" style="font-size: var(--font-size-h2); color: var(--evora-text); margin-bottom: 1rem;">
          {{ section.settings.heading | default: 'Stay in the Loop 💖' }}
        </h2>
        <p style="font-size: 1.55rem; color: var(--evora-text-secondary); line-height: 1.5; margin-bottom: 2rem;">
          {{ section.settings.subheading | default: 'Get wellness tips, app updates, and special offers straight to your inbox.' }}
        </p>

        {% form 'customer', class: 'evora-newsletter__form' %}
          <input type="hidden" name="contact[tags]" value="newsletter">
          <input
            type="email"
            name="contact[email]"
            class="evora-newsletter__input"
            value="{{ form.email }}"
            aria-required="true"
            autocorrect="off"
            autocapitalize="off"
            autocomplete="email"
            placeholder="{{ section.settings.input_placeholder | default: 'Enter your email' }}"
            required
          >
          <button
            type="submit"
            class="evora-btn evora-btn--primary"
            name="commit"
          >
            {{ section.settings.button_label | default: 'Subscribe' }}
          </button>
        {% endform %}
      </div>

      <!-- Right Column: Visual Mockup Peek -->
      <div style="display: flex; justify-content: center; align-items: flex-end; position: relative;">
        {%- if section.settings.device_image != blank -%}
          {{ section.settings.device_image | image_url: width: 600 | image_tag:
            loading: 'lazy',
            style: 'max-width: 280px; height: auto; border-radius: 20px 20px 0 0;'
          }}
        {%- else -%}
          <!-- Built-in CSS App Screen Peek -->
          <div style="width: 260px; background: #FFFFFF; border-radius: 28px 28px 0 0; padding: 2rem 1.6rem 0 1.6rem; box-shadow: 0 -10px 30px rgba(212, 165, 172, 0.25); border: 4px solid #FFFFFF; border-bottom: none;">
            <div style="font-size: 1.25rem; font-weight: 800; color: var(--evora-text); margin-bottom: 0.8rem;">Hi, Sarah! 🌸</div>
            <div style="font-size: 1.05rem; color: var(--evora-muted); margin-bottom: 1.4rem;">How are you feeling today?</div>
            <div class="evora-app-score-card" style="margin-bottom: 1rem;">
              <div class="evora-app-score__circle">
                <span class="evora-app-score__num">82</span>
                <span class="evora-app-score__label">Excellent</span>
              </div>
              <div class="evora-app-score__quote">"You are glowing today."</div>
            </div>
          </div>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Evora Newsletter Banner",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Stay in the Loop 💖"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Get wellness tips, app updates, and special offers straight to your inbox."
    },
    {
      "type": "text",
      "id": "input_placeholder",
      "label": "Input Placeholder",
      "default": "Enter your email"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button Label",
      "default": "Subscribe"
    },
    {
      "type": "image_picker",
      "id": "device_image",
      "label": "Right Custom Image"
    }
  ],
  "presets": [
    {
      "name": "Evora Newsletter Banner"
    }
  ]
}
{% endschema %}
