<script>
  (function() {
    class FooterCustom{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.init();
      }

      init() {
        const currentYear = new Date().getFullYear();
        const copyrightElement = this.querySelector('.ai-footer-copyright-{{ ai_gen_id }}');
        if (copyrightElement && copyrightElement.textContent.includes('{{ "now" | date: "%Y" }}')) {
          copyrightElement.textContent = copyrightElement.textContent.replace('{{ "now" | date: "%Y" }}', currentYear);
        }
      }
    }

    customElements.define('footer-custom-{{ ai_gen_id }}', FooterCustom{{ ai_gen_id }});
  })();
</script>

{% schema %}
{
  "name": "Custom footer",
  "tag": "section",
  "settings": [
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "container_width",
      "label": "Container width",
      "min": 1000,
      "max": 1600,
      "step": 100,
      "unit": "px",
      "default": 1300
    },
    {
      "type": "range",
      "id": "horizontal_padding",
      "label": "Horizontal padding",
      "min": 20,
      "max": 100,
      "step": 10,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 40,
      "max": 120,
      "step": 10,
      "unit": "px",
      "default": 60
    },
    {
      "type": "range",
      "id": "main_padding_bottom",
      "label": "Main section bottom padding",
