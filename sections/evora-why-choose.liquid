{{ 'evora-base.css' | asset_url | stylesheet_tag }}
{{ 'evora-components.css' | asset_url | stylesheet_tag }}

<section
  id="EvoraWhyChoose-{{ section.id }}"
  class="evora-why-choose evora-section-padding evora-bg-surface"
  style="border-top: 1px solid var(--evora-border);"
  data-section-id="{{ section.id }}"
>
  <div class="evora-container">
    <div class="evora-section-header" style="margin-bottom: 4.5rem;">
      <h2 class="evora-section-header__title" style="font-size: clamp(2.4rem, 3.8vw, 3.8rem); font-weight: 800;">
        {{ section.settings.heading | default: 'Why choose Evora?' }}
      </h2>
    </div>

    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 3.5rem; text-align: center;">
      {%- for block in section.blocks -%}
        <div
          class="evora-why-choose__item"
          style="display: flex; flex-direction: column; align-items: center;"
          {{ block.shopify_attributes }}
        >
          <!-- Soft Pink Circle Icon -->
          <div
            style="width: 6.4rem; height: 6.4rem; border-radius: 50%; background: #FDF0F2; color: var(--evora-primary); display: flex; align-items: center; justify-content: center; margin-bottom: 2rem; box-shadow: 0 6px 18px var(--evora-primary-glow);"
          >
            {%- case block.settings.icon -%}
              {%- when 'lock' -%}
                <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
                  <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
                </svg>
              {%- when 'shield' -%}
                <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
                  <path d="m9 12 2 2 4-4"></path>
                </svg>
              {%- else -%}
                <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <circle cx="12" cy="12" r="10"></circle>
                  <polyline points="12 6 12 12 16 14"></polyline>
                </svg>
            {%- endcase -%}
          </div>

          <h3 style="font-size: 2.1rem; font-weight: 800; color: var(--evora-text); margin-bottom: 1.4rem; max-width: 260px; line-height: 1.25;">
            {{ block.settings.title }}
          </h3>

          {%- if block.settings.link_label != blank -%}
            <a
              href="{{ block.settings.link_url | default: '#' }}"
              style="display: inline-flex; align-items: center; gap: 0.6rem; color: #1E6B8B; font-size: 1.5rem; font-weight: 700; text-decoration: none;"
            >
              <span>{{ block.settings.link_label }}</span>
              <span aria-hidden="true">→</span>
            </a>
          {%- endif -%}
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Evora Why Choose",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Why choose Evora?"
    }
  ],
  "blocks": [
    {
      "type": "pillar",
      "name": "Value Pillar",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "clock", "label": "Clock / Predictions" },
            { "value": "lock", "label": "Lock / Privacy" },
            { "value": "shield", "label": "Shield / Medical Trust" }
          ],
          "default": "clock"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Pillar Title",
          "default": "Predictions you can plan around"
        },
        {
          "type": "text",
          "id": "link_label",
          "label": "Link Text",
          "default": "Why we're more than a supplement"
        },
        {
          "type": "url",
          "id": "link_url",
          "label": "Link URL"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Evora Why Choose",
      "blocks": [
        {
          "type": "pillar",
          "settings": {
            "icon": "clock",
            "title": "Predictions you can plan around",
            "link_label": "Why we're more than a powder"
          }
        },
        {
          "type": "pillar",
          "settings": {
            "icon": "lock",
            "title": "Personal data that stays private to you",
            "link_label": "Everything data answered"
          }
        },
        {
          "type": "pillar",
          "settings": {
            "icon": "shield",
            "title": "Partnered by doctors, trusted by millions",
            "link_label": "Meet our medical board"
          }
        }
      ]
    }
  ]
}
{% endschema %}
