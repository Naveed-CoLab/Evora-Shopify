              {{ block.settings.column_1_link_5_text }}
            </a>
          {% endif %}
        </div>

        <div class="ai-footer-nav-column-{{ ai_gen_id }}">
          {% if block.settings.column_2_heading != blank %}
            <h3 class="ai-footer-nav-heading-{{ ai_gen_id }}">{{ block.settings.column_2_heading }}</h3>
          {% endif %}
          {% if block.settings.column_2_link_1_text != blank and block.settings.column_2_link_1_url != blank %}
