                <text x="40" y="13" font-family="Arial, sans-serif" font-size="9" fill="#ffffff">Download on the</text>
                <text x="40" y="26" font-family="Arial, sans-serif" font-size="15" font-weight="bold" fill="#ffffff">App Store</text>
              </svg>
            </a>
          {% endif %}

          {% if block.settings.google_play_url != blank %}
            <a
              href="{{ block.settings.google_play_url }}"
              class="ai-footer-app-badge-{{ ai_gen_id }}"
              target="_blank"
              rel="noopener"
              aria-label="Get it on Google Play"
