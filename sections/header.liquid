{{ 'evora-base.css' | asset_url | stylesheet_tag }}
{{ 'evora-components.css' | asset_url | stylesheet_tag }}
<link rel="stylesheet" href="{{ 'component-list-menu.css' | asset_url }}" media="print" onload="this.media='all'">
<link rel="stylesheet" href="{{ 'component-search.css' | asset_url }}" media="print" onload="this.media='all'">
<link rel="stylesheet" href="{{ 'component-menu-drawer.css' | asset_url }}" media="print" onload="this.media='all'">
<link rel="stylesheet" href="{{ 'component-cart-notification.css' | asset_url }}" media="print" onload="this.media='all'">

<div class="evora-floating-header-wrapper">
  <header class="evora-floating-header" id="EvoraHeader-{{ section.id }}">
    <!-- Mobile Menu Drawer Toggle -->
    <div style="display: flex; align-items: center; gap: 1rem;">
      <header-drawer data-breakpoint="tablet">
        <details id="Details-menu-drawer-container" class="menu-drawer-container">
          <summary class="header__icon header__icon--menu header__icon--summary link focus-inset" aria-label="{{ 'sections.header.menu' | t }}" style="display: flex; align-items: center; justify-content: center; width: 36px; height: 36px; color: var(--evora-text);">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
              <line x1="3" y1="12" x2="21" y2="12"></line>
              <line x1="3" y1="6" x2="21" y2="6"></line>
              <line x1="3" y1="18" x2="21" y2="18"></line>
            </svg>
          </summary>
          <div id="menu-drawer" class="gradient menu-drawer motion-reduce color-{{ section.settings.menu_color_scheme }}">
            <div class="menu-drawer__inner-container">
              <div class="menu-drawer__navigation-container">
                <nav class="menu-drawer__navigation">
                  <ul class="menu-drawer__menu has-submenu list-menu" role="list">
                    {%- for link in section.settings.menu.links -%}
                      <li>
                        <a href="{{ link.url }}" class="menu-drawer__menu-item list-menu__item link link--text focus-inset {% if link.current %}menu-drawer__menu-item--active{% endif %}">
                          {{ link.title | escape }}
                        </a>
                      </li>
                    {%- endfor -%}
                  </ul>
                </nav>
              </div>
            </div>
          </div>
        </details>
      </header-drawer>

      <!-- Logo -->
      <a href="{{ routes.root_url }}" class="evora-header__logo">
        {%- if settings.logo != blank -%}
          {{ settings.logo | image_url: width: 240 | image_tag:
            loading: 'eager',
            style: 'max-height: 38px; width: auto; object-fit: contain;',
            alt: shop.name
          }}
        {%- else -%}
          <!-- Stylized Flow / Evora Brand SVG Icon -->
          <svg width="28" height="28" viewBox="0 0 28 28" fill="none" style="flex-shrink: 0;">
            <rect width="28" height="28" rx="8" fill="#24222A"/>
            <path d="M7 9H18M7 14H15M7 19H21" stroke="#FF5B82" stroke-width="3" stroke-linecap="round"/>
          </svg>
          <span>{{ section.settings.brand_name | default: 'Flow' }}</span>
        {%- endif -%}
      </a>
    </div>

    <!-- Center Navigation Links -->
    <nav class="evora-header__nav" aria-label="Main Navigation">
      {%- for link in section.settings.menu.links -%}
        <a
          href="{{ link.url }}"
          class="evora-header__link {% if link.current or forloop.first and template.name == 'index' %}evora-header__link--active{% endif %}"
        >
          {{ link.title | escape }}
        </a>
      {%- else -%}
        <!-- Fallback Default Nav Links -->
        <a href="/" class="evora-header__link {% if template.name == 'index' %}evora-header__link--active{% endif %}">Home</a>
        <a href="/collections/all" class="evora-header__link {% if template.name == 'product' or template.name == 'collection' %}evora-header__link--active{% endif %}">Shop</a>
        <a href="/pages/faq" class="evora-header__link">FAQ</a>
        <a href="/pages/contact" class="evora-header__link">Contact Us</a>
      {%- endfor -%}
    </nav>

    <!-- Right Actions & CTA Button -->
    <div class="evora-header__actions">
      <!-- Search Icon -->
      <a href="{{ routes.search_url }}" style="color: var(--evora-text); display: flex; align-items: center; justify-content: center; text-decoration: none;" aria-label="Search">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="11" cy="11" r="8"></circle>
          <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
        </svg>
      </a>

      <!-- Cart Icon -->
      <a href="{{ routes.cart_url }}" id="cart-icon-bubble" style="color: var(--evora-text); display: flex; align-items: center; justify-content: center; text-decoration: none; position: relative;" aria-label="Cart">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"></path>
          <line x1="3" y1="6" x2="21" y2="6"></line>
          <path d="M16 10a4 4 0 0 1-8 0"></path>
        </svg>
        {%- if cart.item_count > 0 -%}
          <span style="position: absolute; top: -6px; right: -8px; background: #FF5B82; color: #fff; border-radius: 50%; font-size: 1rem; width: 16px; height: 16px; display: flex; align-items: center; justify-content: center; font-weight: 800;">
            {{ cart.item_count }}
          </span>
        {%- endif -%}
      </a>

      <!-- CTA Button -->
      {%- if section.settings.show_cta_button -%}
        <a
          href="{{ section.settings.cta_button_link | default: '/collections/all' }}"
          class="evora-header__cta"
        >
          {{ section.settings.cta_button_text | default: 'Order Now' }}
        </a>
      {%- endif -%}
    </div>
  </header>
</div>

{% schema %}
{
  "name": "Floating Pill Header",
  "class": "section-header",
  "settings": [
    {
      "type": "text",
      "id": "brand_name",
      "label": "Brand Name Fallback",
      "default": "Flow"
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "Menu",
      "default": "main-menu"
    },
    {
      "type": "checkbox",
      "id": "show_cta_button",
      "label": "Show Right CTA Button",
      "default": true
    },
    {
      "type": "text",
      "id": "cta_button_text",
      "label": "CTA Button Text",
      "default": "Order Now"
    },
    {
      "type": "url",
      "id": "cta_button_link",
      "label": "CTA Button Link"
    }
  ]
}
{% endschema %}
