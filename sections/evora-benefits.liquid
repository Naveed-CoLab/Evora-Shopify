{{ 'evora-base.css' | asset_url | stylesheet_tag }}
{{ 'evora-components.css' | asset_url | stylesheet_tag }}
{{ 'evora-responsive.css' | asset_url | stylesheet_tag }}

<section
  id="EvoraBenefits-{{ section.id }}"
  class="evora-benefits evora-section-padding evora-bg-surface"
  data-section-id="{{ section.id }}"
>
  <div class="evora-container">
    <div class="evora-section-header">
      {%- if section.settings.badge_text != blank -%}
        <div class="evora-section-header__badge">
          {{ section.settings.badge_text }}
        </div>
      {%- endif -%}

      {%- if section.settings.heading != blank -%}
        <h2 class="evora-section-header__title">
          {{ section.settings.heading }}
        </h2>
      {%- endif -%}

      {%- if section.settings.subheading != blank -%}
        <div class="evora-section-header__subtitle">
          {{ section.settings.subheading }}
        </div>
      {%- endif -%}
    </div>

    <div class="evora-benefits-grid">
      {%- for block in section.blocks -%}
        <div
          class="evora-card evora-card--hover-lift"
          style="background: var(--evora-surface-soft); border-color: var(--evora-border);"
          {{ block.shopify_attributes }}
        >
          <div class="evora-icon-box" style="margin-bottom: 1.8rem;">
            {%- case block.settings.icon -%}
              {%- when 'heart' -%}
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path>
                </svg>
              {%- when 'sparkle' -%}
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M12 2v20M2 12h20M4.93 4.93l14.14 14.14M4.93 19.07l14.14-14.14"/>
                </svg>
              {%- when 'leaf' -%}
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M11 20A7 7 0 0 1 9.8 6.1C15.5 5 17 4.48 19 2c1 2 2 4.18 2 8 0 5.5-4.78 10-10 10Z"></path>
                  <path d="M2 21c0-3 1.85-5.36 5.08-6C9.5 14.52 12 13 13 12"></path>
                </svg>
              {%- when 'moon' -%}
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
                </svg>
              {%- else -%}
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <circle cx="12" cy="12" r="10"></circle>
                  <path d="m9 12 2 2 4-4"></path>
                </svg>
            {%- endcase -%}
          </div>

          {%- if block.settings.badge_tag != blank -%}
            <span class="evora-badge evora-badge--secondary" style="margin-bottom: 1rem; font-size: 1.15rem; padding: 0.2rem 0.9rem;">
              {{ block.settings.badge_tag }}
            </span>
          {%- endif -%}

          <h3 style="font-size: 1.85rem; font-weight: 700; color: var(--evora-text); margin-bottom: 0.8rem;">
            {{ block.settings.title }}
          </h3>

          <div style="font-size: 1.45rem; line-height: 1.6; color: var(--evora-text-secondary);">
            {{ block.settings.text }}
          </div>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Evora Benefits",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "badge_text",
      "label": "Badge Text",
      "default": "Targeted Nutrition"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Engineered for female physiological rhythm"
    },
    {
      "type": "richtext",
      "id": "subheading",
      "label": "Subheading",
      "default": "<p>Carefully formulated with bioactive adaptogens, micronutrients, and prebiotic fibers to support your body 365 days a year.</p>"
    }
  ],
  "blocks": [
    {
      "type": "benefit_card",
      "name": "Benefit Card",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "heart", "label": "Heart / Hormone Balance" },
            { "value": "sparkle", "label": "Sparkle / Energy & Glow" },
            { "value": "leaf", "label": "Leaf / Gut Health" },
            { "value": "moon", "label": "Moon / Sleep & Calming" }
          ],
          "default": "heart"
        },
        {
          "type": "text",
          "id": "badge_tag",
          "label": "Small Tag",
          "default": "Phase Support"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Benefit Title",
          "default": "Hormonal Equilibrium"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Benefit Description",
          "default": "<p>Eases PMS symptoms, regulates cortisol peaks, and supports calm mental clarity during every phase.</p>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Evora Benefits",
      "blocks": [
        {
          "type": "benefit_card",
          "settings": {
            "icon": "heart",
            "badge_tag": "Cycle Harmony",
            "title": "Hormonal Equilibrium",
            "text": "<p>Targeted bio-adaptogens smooth out cortisol spikes, reduce cycle discomfort, and stabilize mood.</p>"
          }
        },
        {
          "type": "benefit_card",
          "settings": {
            "icon": "sparkle",
            "badge_tag": "Sustained Vitality",
            "title": "Clean, Jitter-Free Energy",
            "text": "<p>Active B-complex and cellular CoQ10 power steady all-day focus without caffeine crashes.</p>"
          }
        },
        {
          "type": "benefit_card",
          "settings": {
            "icon": "leaf",
            "badge_tag": "Microbiome Focus",
            "title": "Gut Harmony & Digestion",
            "text": "<p>Gentle prebiotic botanicals nurture gut flora, soothing bloating and enhancing nutrient absorption.</p>"
          }
        },
        {
          "type": "benefit_card",
          "settings": {
            "icon": "moon",
            "badge_tag": "Recovery & Sleep",
            "title": "Deep Rest & Radiant Skin",
            "text": "<p>Magnesium bisglycinate and hyaluronic precursors rejuvenate skin barriers while supporting deep REM sleep.</p>"
          }
        }
      ]
    }
  ]
}
{% endschema %}
