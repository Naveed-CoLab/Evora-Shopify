{{ 'evora-base.css' | asset_url | stylesheet_tag }}
{{ 'evora-components.css' | asset_url | stylesheet_tag }}

<section
  id="EvoraTrustBar-{{ section.id }}"
  class="evora-trust-bar"
  style="padding: 2.8rem 0; border-top: 1px solid var(--evora-border); border-bottom: 1px solid var(--evora-border); background: var(--evora-surface);"
  data-section-id="{{ section.id }}"
>
  <div class="evora-container">
    {%- if section.settings.heading != blank -%}
      <p style="text-align: center; font-size: 1.25rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.1em; color: var(--evora-muted); margin-bottom: 2rem;">
        {{ section.settings.heading }}
      </p>
    {%- endif -%}

    <div
      class="evora-trust-bar__items"
      style="display: flex; align-items: center; justify-content: center; gap: 3rem; flex-wrap: wrap;"
    >
      {%- for block in section.blocks -%}
        <div
          class="evora-trust-bar__item"
          style="display: flex; align-items: center; gap: 1rem; color: var(--evora-text); font-size: 1.45rem; font-weight: 600;"
          {{ block.shopify_attributes }}
        >
          <div
            style="width: 3.2rem; height: 3.2rem; border-radius: 50%; background: var(--evora-primary-light); color: var(--evora-primary); display: flex; align-items: center; justify-content: center; flex-shrink: 0;"
          >
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="20 6 9 17 4 12"></polyline>
            </svg>
          </div>
          <span>{{ block.settings.title }}</span>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Evora Trust Bar",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Small Header Text",
      "default": "FORMULATED WITH CLINICAL INTEGRITY & BACKED BY WOMEN'S HEALTH EXPERTS"
    }
  ],
  "blocks": [
    {
      "type": "trust_item",
      "name": "Trust Metric",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Metric / Certification",
          "default": "OB-GYN Formulated"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Evora Trust Bar",
      "blocks": [
        {
          "type": "trust_item",
          "settings": {
            "title": "OB-GYN Formulated"
          }
        },
        {
          "type": "trust_item",
          "settings": {
            "title": "100% Bio-Available"
          }
        },
        {
          "type": "trust_item",
          "settings": {
            "title": "Non-GMO & Vegan"
          }
        },
        {
          "type": "trust_item",
          "settings": {
            "title": "Third-Party Tested"
          }
        },
        {
          "type": "trust_item",
          "settings": {
            "title": "Zero Artificial Sweeteners"
          }
        }
      ]
    }
  ]
}
{% endschema %}
