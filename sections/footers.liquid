                <path d="M23 20L8.5 32.5c.1.1.3.2.5.2.1 0 .3 0 .4-.1l16.1-9.1L23 20z" fill="#FFCE00"/>
                <path d="M25.5 23.5l-16.1 9.1c-.1.1-.3.1-.4.1-.2 0-.4-.1-.5-.2L23 20l2.5 3.5z" fill="#00AB4E"/>
