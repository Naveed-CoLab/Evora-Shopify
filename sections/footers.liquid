                <text x="45" y="12" font-family="Arial, sans-serif" font-size="7" fill="#ffffff">GET IT ON</text>
                <text x="45" y="25" font-family="Arial, sans-serif" font-size="13" font-weight="bold" fill="#ffffff">Google Play</text>
              </svg>
            </a>
          {% endif %}
        </div>
      </div>

      <div class="ai-footer-right-{{ ai_gen_id }}">
        <div class="ai-footer-nav-column-{{ ai_gen_id }}">
          {% if block.settings.column_1_heading != blank %}
