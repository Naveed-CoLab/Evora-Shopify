```liquid
{% doc %}
  @prompt
    Create a modern wellness hero CTA Theme Block. Use a user-uploaded background image that covers the entire hero section. Layout: product/logo image on the left, centered headline and subtitle with two CTA buttons, and phone mockup on the right. Use a soft feminine wellness aesthetic inspired by modern health brands. Remove the feature icon row completely. Make the block fully responsive and customizable through the Shopify visual editor.
{% enddoc %}

{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-hero-cta-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    overflow: hidden;
    padding: {{ block.settings.section_padding_top }}px {{ block.settings.section_padding_horizontal }}px {{ block.settings.section_padding_bottom }}px;
    background-color: #f8e8ed;
    {% if block.settings.background_image %}
      background-image: url('{{ block.settings.background_image | image_url: width: 2400 }}');
      background-size: cover;
      background-position: center center;
      background-repeat: no-repeat;
    {% endif %}
  }

  .ai-hero-cta-{{ ai_gen_id }}::before {
    content: "";
    position: absolute;
    inset: 0;
    background: {{ block.settings.background_overlay }};
    opacity: {{ block.settings.overlay_opacity | divided_by: 100.0 }};
    pointer-events: none;
    z-index: 0;
  }

  .ai-hero-cta-container-{{ ai_gen_id }} {
    position: relative;
    z-index: 1;
    width: 100%;
    max-width: {{ block.settings.container_max_width }}px;
    margin: 0 auto;
  }

  .ai-hero-cta-main-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: minmax(140px, {{ block.settings.logo_width }}px) minmax(0, 1fr) minmax(160px, {{ block.settings.phone_width }}px);
    align-items: center;
    gap: {{ block.settings.content_gap }}px;
    min-height: {{ block.settings.hero_min_height }}px;
  }

  /* Logo / Product */
  .ai-hero-cta-logo-{{ ai_gen_id }} {
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-hero-cta-logo-{{ ai_gen_id }} img {
    display: block;
    width: 100%;
    max-width: {{ block.settings.logo_width }}px;
    height: auto;
    object-fit: contain;
  }

  /* Center content */
  .ai-hero-cta-content-{{ ai_gen_id }} {
    text-align: {{ block.settings.text_alignment }};
    max-width: 720px;
    margin: 0 auto;
    width: 100%;
  }

  .ai-hero-cta-headline-{{ ai_gen_id }} {
    margin: 0 0 {{ block.settings.headline_spacing }}px;
    color: {{ block.settings.headline_color }};
    font-size: {{ block.settings.headline_size }}px;
    font-weight: {{ block.settings.headline_weight }};
    line-height: 1.08;
    letter-spacing: -0.03em;
  }

  .ai-hero-cta-headline-{{ ai_gen_id }} em {
    color: {{ block.settings.headline_accent_color }};
    font-style: normal;
  }

  .ai-hero-cta-subtitle-{{ ai_gen_id }} {
    max-width: {{ block.settings.subtitle_max_width }}px;
    margin: 0 auto {{ block.settings.subtitle_spacing }}px;
    color: {{ block.settings.subtitle_color }};
    font-size: {{ block.settings.subtitle_size }}px;
    line-height: 1.55;
  }

  .ai-hero-cta-subtitle-{{ ai_gen_id }} p {
    margin: 0;
  }

  .ai-hero-cta-buttons-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: {{ block.settings.button_gap }}px;
    flex-wrap: wrap;
  }

  .ai-hero-cta-button-{{ ai_gen_id }} {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    min-height: 52px;
    padding: {{ block.settings.button_padding_vertical }}px {{ block.settings.button_padding_horizontal }}px;
    border-radius: {{ block.settings.button_border_radius }}px;
    border: 2px solid transparent;
    font-size: {{ block.settings.button_font_size }}px;
    font-weight: {{ block.settings.button_font_weight }};
    line-height: 1;
    text-decoration: none;
    white-space: nowrap;
    transition:
      transform 0.2s ease,
      box-shadow 0.2s ease,
      background-color 0.2s ease,
      border-color 0.2s ease;
  }

  .ai-hero-cta-button-primary-{{ ai_gen_id }} {
    background: {{ block.settings.primary_button_bg }};
    color: {{ block.settings.primary_button_color }};
    border-color: {{ block.settings.primary_button_bg }};
  }

  .ai-hero-cta-button-primary-{{ ai_gen_id }}:hover {
    background: {{ block.settings.primary_button_hover_bg }};
    border-color: {{ block.settings.primary_button_hover_bg }};
    color: {{ block.settings.primary_button_color }};
    transform: translateY(-2px);
    box-shadow: 0 10px 24px rgba(255, 91, 130, 0.22);
  }

  .ai-hero-cta-button-secondary-{{ ai_gen_id }} {
    background: transparent;
    color: {{ block.settings.secondary_button_color }};
    border-color: {{ block.settings.secondary_button_border }};
  }

  .ai-hero-cta-button-secondary-{{ ai_gen_id }}:hover {
    background: {{ block.settings.secondary_button_hover_bg }};
    border-color: {{ block.settings.secondary_button_hover_border }};
    color: {{ block.settings.secondary_button_color }};
    transform: translateY(-2px);
  }

  .ai-hero-cta-arrow-{{ ai_gen_id }} {
    width: 17px;
    height: 17px;
    transition: transform 0.2s ease;
  }

  .ai-hero-cta-button-secondary-{{ ai_gen_id }}:hover .ai-hero-cta-arrow-{{ ai_gen_id }} {
    transform: translateX(4px);
  }

  /* Phone */
  .ai-hero-cta-phone-{{ ai_gen_id }} {
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-hero-cta-phone-{{ ai_gen_id }} img {
    display: block;
    width: 100%;
    max-width: {{ block.settings.phone_width }}px;
    height: auto;
    object-fit: contain;
  }

  /* Empty image states */
  .ai-hero-cta-placeholder-{{ ai_gen_id }} {
    width: 100%;
    aspect-ratio: 1 / 1.15;
    border-radius: 24px;
    background: rgba(255,255,255,0.45);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-hero-cta-placeholder-{{ ai_gen_id }} svg {
    width: 55%;
    height: 55%;
    opacity: 0.35;
  }

  /* Tablet */
  @media screen and (max-width: 989px) {
    .ai-hero-cta-{{ ai_gen_id }} {
      padding-left: 28px;
      padding-right: 28px;
    }

    .ai-hero-cta-main-{{ ai_gen_id }} {
      grid-template-columns: 180px minmax(0, 1fr) 180px;
      gap: 24px;
      min-height: auto;
    }

    .ai-hero-cta-headline-{{ ai_gen_id }} {
      font-size: 42px;
    }

    .ai-hero-cta-subtitle-{{ ai_gen_id }} {
      font-size: 16px;
    }
  }

  /* Mobile */
  @media screen and (max-width: 749px) {
    .ai-hero-cta-{{ ai_gen_id }} {
      padding:
        {{ block.settings.section_padding_top | times: 0.6 }}px
        20px
        {{ block.settings.section_padding_bottom | times: 0.6 }}px;
    }

    .ai-hero-cta-main-{{ ai_gen_id }} {
      display: flex;
      flex-direction: column;
      gap: 28px;
      min-height: auto;
    }

    .ai-hero-cta-logo-{{ ai_gen_id }} {
      order: 1;
    }

    .ai-hero-cta-content-{{ ai_gen_id }} {
      order: 2;
      text-align: center;
    }

    .ai-hero-cta-phone-{{ ai_gen_id }} {
      order: 3;
    }

    .ai-hero-cta-logo-{{ ai_gen_id }} img {
      max-width: {{ block.settings.logo_width | times: 0.7 }}px;
    }

    .ai-hero-cta-phone-{{ ai_gen_id }} img {
      max-width: {{ block.settings.phone_width | times: 0.75 }}px;
    }

    .ai-hero-cta-headline-{{ ai_gen_id }} {
      font-size: {{ block.settings.headline_size | times: 0.58 }}px;
      line-height: 1.08;
    }

    .ai-hero-cta-subtitle-{{ ai_gen_id }} {
      font-size: 15px;
      max-width: 500px;
    }

    .ai-hero-cta-buttons-{{ ai_gen_id }} {
      width: 100%;
      flex-direction: column;
    }

    .ai-hero-cta-button-{{ ai_gen_id }} {
      width: 100%;
      max-width: 340px;
    }
  }
{% endstyle %}

<hero-cta-{{ ai_gen_id }}
  class="ai-hero-cta-{{ ai_gen_id }}"
  {{ block.shopify_attributes }}
>
  <div class="ai-hero-cta-container-{{ ai_gen_id }}">

    <div class="ai-hero-cta-main-{{ ai_gen_id }}">

      <!-- LEFT: Product / Logo -->
      <div class="ai-hero-cta-logo-{{ ai_gen_id }}">
        {% if block.settings.logo_image %}
          <img
            src="{{ block.settings.logo_image | image_url: width: 600 }}"
            alt="{{ block.settings.logo_image.alt | default: shop.name | escape }}"
            loading="eager"
            width="{{ block.settings.logo_image.width }}"
            height="{{ block.settings.logo_image.height }}"
          >
        {% else %}
          <div class="ai-hero-cta-placeholder-{{ ai_gen_id }}">
            {{ 'product-1' | placeholder_svg_tag }}
          </div>
        {% endif %}
      </div>

      <!-- CENTER: Content -->
      <div class="ai-hero-cta-content-{{ ai_gen_id }}">

        {% if block.settings.headline != blank %}
          <h1 class="ai-hero-cta-headline-{{ ai_gen_id }}">
            {{ block.settings.headline }}
          </h1>
        {% endif %}

        {% if block.settings.subtitle != blank %}
          <div class="ai-hero-cta-subtitle-{{ ai_gen_id }}">
            {{ block.settings.subtitle }}
          </div>
        {% endif %}

        <div class="ai-hero-cta-buttons-{{ ai_gen_id }}">

          {% if block.settings.primary_button_label != blank %}
            <a
              href="{{ block.settings.primary_button_link | default: '#' }}"
              class="ai-hero-cta-button-{{ ai_gen_id }} ai-hero-cta-button-primary-{{ ai_gen_id }}"
            >
              {{ block.settings.primary_button_label }}
            </a>
          {% endif %}

          {% if block.settings.secondary_button_label != blank %}
            <a
              href="{{ block.settings.secondary_button_link | default: '#' }}"
              class="ai-hero-cta-button-{{ ai_gen_id }} ai-hero-cta-button-secondary-{{ ai_gen_id }}"
            >
              {{ block.settings.secondary_button_label }}

              <svg
                class="ai-hero-cta-arrow-{{ ai_gen_id }}"
                viewBox="0 0 16 16"
                fill="none"
                xmlns="http://www.w3.org/2000/svg"
                aria-hidden="true"
              >
                <path
                  d="M1 8H15M15 8L8 1M15 8L8 15"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                />
              </svg>
            </a>
          {% endif %}

        </div>
      </div>

      <!-- RIGHT: Phone -->
      <div class="ai-hero-cta-phone-{{ ai_gen_id }}">
        {% if block.settings.phone_image %}
          <img
            src="{{ block.settings.phone_image | image_url: width: 800 }}"
            alt="{{ block.settings.phone_image.alt | default: 'App preview' | escape }}"
            loading="eager"
            width="{{ block.settings.phone_image.width }}"
            height="{{ block.settings.phone_image.height }}"
          >
        {% else %}
          <div class="ai-hero-cta-placeholder-{{ ai_gen_id }}">
            {{ 'image' | placeholder_svg_tag }}
          </div>
        {% endif %}
      </div>

    </div>
  </div>
</hero-cta-{{ ai_gen_id }}>

