{% comment %}
  Renders an Evora rounded card container.
  Accepts:
  - title: {String} Card title
  - subtitle: {String} Card subtitle
  - text: {String} Card description text or richtext
  - icon: {String} SVG icon or HTML
  - style: {String} 'default' | 'soft' | 'glass'
  - hover_lift: {Boolean} Add hover lift effect
  - class: {String} Additional classes

  Usage:
  {% render 'evora-card', title: 'Hormonal Harmony', text: 'Balances cortisol and supports natural rhythms.' %}
{% endcomment %}

{%- liquid
  assign card_style = style | default: 'default'
-%}

<div class="evora-card evora-card--{{ card_style }}{% if hover_lift %} evora-card--hover-lift{% endif %}{% if class != blank %} {{ class }}{% endif %}">
  {%- if icon != blank -%}
    <div class="evora-icon-box" aria-hidden="true">
      {{ icon }}
    </div>
  {%- endif -%}

  {%- if title != blank -%}
    <h3 class="evora-card__title" style="font-size: 1.9rem; margin-bottom: 0.8rem; font-weight: 700;">
      {{ title }}
    </h3>
  {%- endif -%}

  {%- if subtitle != blank -%}
    <p class="evora-card__subtitle" style="font-size: 1.35rem; color: var(--evora-primary); font-weight: 600; margin-bottom: 0.6rem;">
      {{ subtitle }}
    </p>
  {%- endif -%}

  {%- if text != blank -%}
    <div class="evora-card__text" style="font-size: 1.5rem; line-height: 1.6; color: var(--evora-text-secondary);">
      {{ text }}
    </div>
  {%- endif -%}
</div>
