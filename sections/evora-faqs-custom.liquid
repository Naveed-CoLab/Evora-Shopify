{% assign sid = section.id %}

{% style %}
  /* ── Section wrapper ─────────────────────────────── */
  .faq_section-{{ sid }} {
    background-color: {{ section.settings.background_color }};
    font-family: var(--font-body-family, var(--font-inter-display, 'Inter Display', sans-serif));
  }

  .section-{{ sid }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ sid }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  /* ── Section heading ─────────────────────────────── */
  .faq_section-{{ sid }} .faq_heading {
    font-size: {{ section.settings.heading_size }}px;
    font-weight: 700;
    color: {{ section.settings.heading_color }};
    margin: 0 0 {{ section.settings.heading_margin_bottom }}px;
    line-height: 1.2;
    letter-spacing: -0.02em;
  }

  @media screen and (max-width: 749px) {
    .faq_section-{{ sid }} .faq_heading {
      font-size: {{ section.settings.heading_size | minus: 8 }}px;
    }
  }

  /* ── FAQ list ────────────────────────────────────── */
  .faq_section-{{ sid }} .faq_list {
    display: flex;
    flex-direction: column;
    gap: 0;
    border-top: 1px solid {{ section.settings.border_color }};
  }

  /* ── FAQ card (one row) ──────────────────────────── */
  .faq_section-{{ sid }} .faq_card {
    border-bottom: 1px solid {{ section.settings.border_color }};
    overflow: hidden;
  }

  /* ── Trigger button ──────────────────────────────── */
  .faq_section-{{ sid }} .faq_header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    padding: {{ section.settings.card_padding_vertical }}px 0;
    background: none;
    border: none;
    cursor: pointer;
    text-align: left;
    gap: 16px;
    -webkit-appearance: none;
    appearance: none;
  }

  .faq_section-{{ sid }} .faq_header:focus-visible {
    outline: 2px solid {{ section.settings.question_color }};
    outline-offset: 2px;
    border-radius: 4px;
  }

  /* ── Question text ───────────────────────────────── */
  .faq_section-{{ sid }} .faq_title {
    font-size: {{ section.settings.question_size }}px;
    font-weight: {{ section.settings.question_weight }};
    color: {{ section.settings.question_color }};
    line-height: 1.4;
    flex: 1;
    font-family: inherit;
  }

  @media screen and (max-width: 749px) {
    .faq_section-{{ sid }} .faq_title {
      font-size: {{ section.settings.question_size | minus: 2 }}px;
    }
  }

  /* ── Chevron icon ────────────────────────────────── */
  .faq_section-{{ sid }} .faq_chevron {
    flex-shrink: 0;
    width: 24px;
    height: 24px;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .faq_section-{{ sid }} .faq_chevron svg {
    width: 18px;
    height: 18px;
    display: block;
    stroke: {{ section.settings.chevron_color }};
    fill: none;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
    transition: stroke 0.2s;
  }

  .faq_section-{{ sid }} .faq_card.is_open .faq_chevron {
    transform: rotate(180deg);
  }

  /* ── Answer panel — smooth CSS grid trick ────────── */
  .faq_section-{{ sid }} .faq_content {
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows 0.35s cubic-bezier(0.4, 0, 0.2, 1);
    overflow: hidden;
  }

  .faq_section-{{ sid }} .faq_content_inner {
    overflow: hidden;
    min-height: 0;
  }

  .faq_section-{{ sid }} .faq_card.is_open .faq_content {
    grid-template-rows: 1fr;
  }

  /* ── Answer text ─────────────────────────────────── */
  .faq_section-{{ sid }} .faq_answer {
    padding-bottom: {{ section.settings.card_padding_vertical }}px;
    font-size: {{ section.settings.answer_size }}px;
    color: {{ section.settings.answer_color }};
    line-height: 1.65;
    font-family: inherit;
  }

  .faq_section-{{ sid }} .faq_answer p {
    margin: 0 0 10px;
  }

  .faq_section-{{ sid }} .faq_answer p:last-child {
    margin-bottom: 0;
  }

  .faq_section-{{ sid }} .faq_answer a {
    color: {{ section.settings.question_color }};
    text-decoration: underline;
  }

  .faq_section-{{ sid }} .faq_answer ul,
  .faq_section-{{ sid }} .faq_answer ol {
    margin: 0 0 10px;
    padding-left: 20px;
  }

  .faq_section-{{ sid }} .faq_answer li {
    margin-bottom: 4px;
  }
{% endstyle %}

<div
  class="faq_section-{{ sid }} section-{{ sid }}-padding"
  id="faq_section_{{ sid }}"
  {{ section.shopify_attributes }}
>
  <div class="page-width">

    {%- if section.settings.heading != blank -%}
      <h2 class="faq_heading">{{ section.settings.heading }}</h2>
    {%- endif -%}

    <div class="faq_list" data-section-id="{{ sid }}" data-single-open="{{ section.settings.single_open }}">
      {%- for block in section.blocks -%}
        {%- if block.type == 'faq-item' -%}
          {%- if forloop.first and section.settings.open_first -%}
            {%- assign is_first_open = true -%}
          {%- else -%}
            {%- assign is_first_open = false -%}
          {%- endif -%}
          <div
            class="faq_card{% if is_first_open %} is_open{% endif %}"
            {{ block.shopify_attributes }}
          >
            <button
              type="button"
              class="faq_header"
              aria-expanded="{% if is_first_open %}true{% else %}false{% endif %}"
              aria-controls="faq_content_{{ sid }}_{{ forloop.index }}"
            >
              <span class="faq_title">{{ block.settings.question }}</span>
              <span class="faq_chevron" aria-hidden="true">
                <svg viewBox="0 0 18 18" xmlns="http://www.w3.org/2000/svg">
                  <path d="M3.5 6.5L9 12L14.5 6.5"/>
                </svg>
              </span>
            </button>

            <div
              class="faq_content"
              id="faq_content_{{ sid }}_{{ forloop.index }}"
              role="region"
            >
              <div class="faq_content_inner">
                <div class="faq_answer">
                  {{ block.settings.answer }}
                </div>
              </div>
            </div>
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>

  </div>
</div>

<script>
(function () {
  var sid = '{{ sid }}';
  var list = document.querySelector('[data-section-id="' + sid + '"]');
  if (!list) return;

  var singleOpen = list.dataset.singleOpen === 'true';

  function openCard(card, btn) {
    card.classList.add('is_open');
    btn.setAttribute('aria-expanded', 'true');
  }

  function closeCard(card, btn) {
    card.classList.remove('is_open');
    btn.setAttribute('aria-expanded', 'false');
  }

  list.addEventListener('click', function (e) {
    var btn = e.target.closest('.faq_header');
    if (!btn) return;

    var card = btn.closest('.faq_card');
    var isCurrentlyOpen = card.classList.contains('is_open');

    if (singleOpen) {
      list.querySelectorAll('.faq_card.is_open').forEach(function (c) {
        closeCard(c, c.querySelector('.faq_header'));
      });
    }

    if (!isCurrentlyOpen) {
      openCard(card, btn);
    }
  });
})();
</script>

{% schema %}
{
  "name": "FAQ Section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Section heading",
