{{ 'evora-base.css' | asset_url | stylesheet_tag }}
{{ 'evora-components.css' | asset_url | stylesheet_tag }}

<section
  id="EvoraVideoBanner-{{ section.id }}"
  class="evora-video-banner evora-section-padding"
  style="background: linear-gradient(180deg, #FDF9F8 0%, #FFFFFF 100%);"
  data-section-id="{{ section.id }}"
>
  <div class="evora-container">
    <div
      class="evora-video-container"
      style="border-radius: 32px; overflow: hidden; position: relative; background: #222026; box-shadow: 0 20px 48px rgba(34, 32, 38, 0.12); max-width: 1040px; margin: 0 auto; aspect-ratio: 16 / 9; display: flex; align-items: center; justify-content: center;"
    >
      {%- if section.settings.video_url != blank -%}
        <iframe
          src="{{ section.settings.video_url }}"
          style="width: 100%; height: 100%; border: none;"
          allow="autoplay; encrypted-media"
          allowfullscreen
        ></iframe>
      {%- else -%}
        <!-- Stylized Lifestyle Poster with Play Overlay -->
        <div style="position: absolute; inset: 0; background: linear-gradient(180deg, rgba(34,32,38,0.2) 0%, rgba(34,32,38,0.6) 100%); display: flex; flex-direction: column; align-items: center; justify-content: center; color: #FFFFFF; padding: 2rem; text-align: center;">
          <!-- Glowing Play Button -->
          <div
            style="width: 76px; height: 76px; border-radius: 50%; background: rgba(255, 255, 255, 0.92); color: var(--evora-primary); display: flex; align-items: center; justify-content: center; box-shadow: 0 8px 30px rgba(0, 0, 0, 0.3); margin-bottom: 2rem; cursor: pointer; transition: transform 0.2s ease;"
          >
            <svg width="30" height="30" viewBox="0 0 24 24" fill="currentColor"><polygon points="5 3 19 12 5 21 5 3"></polygon></svg>
          </div>

          <span style="font-size: 1.3rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.12em; color: rgba(255,255,255,0.8); margin-bottom: 0.8rem;">
            {{ section.settings.tag | default: 'THE EVORA STORY' }}
          </span>
          <h3 style="font-size: clamp(2rem, 3.2vw, 3.2rem); font-weight: 800; color: #FFFFFF; max-width: 600px; line-height: 1.2;">
            {{ section.settings.heading | default: 'Bridging clinical nutrition with daily body intelligence' }}
          </h3>
        </div>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Evora Video Spotlight",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "tag",
      "label": "Small Tag",
      "default": "THE EVORA STORY"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Headline Overlay",
      "default": "Bridging clinical nutrition with daily body intelligence"
    },
    {
      "type": "video_url",
      "id": "video_url",
      "label": "Video URL (YouTube/Vimeo)",
      "accept": ["youtube", "vimeo"]
    }
  ],
  "presets": [
    {
      "name": "Evora Video Spotlight"
    }
  ]
}
{% endschema %}
