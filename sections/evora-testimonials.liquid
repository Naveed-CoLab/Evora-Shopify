{{ 'evora-base.css' | asset_url | stylesheet_tag }}
{{ 'evora-components.css' | asset_url | stylesheet_tag }}

<section
  id="EvoraTestimonials-{{ section.id }}"
  class="evora-section-padding evora-bg-surface"
  data-section-id="{{ section.id }}"
>
  <div class="evora-container">
    <div class="evora-section-header">
      <h2 class="evora-section-header__title evora-serif">
        {{ section.settings.heading | default: 'Loved by Thousands of Women' }}
      </h2>
      <div class="evora-section-header__description">
        {{ section.settings.subheading | default: 'Our community is growing stronger every day.' }}
      </div>
    </div>

    <div class="evora-testimonials-grid">
      {%- for block in section.blocks -%}
        <div class="evora-testimonial-card" {{ block.shopify_attributes }}>
          {%- if block.settings.avatar != blank -%}
            {{ block.settings.avatar | image_url: width: 140 | image_tag:
              class: 'evora-testimonial-card__avatar',
              loading: 'lazy',
              alt: block.settings.author
            }}
          {%- elsif block.settings.avatar_url != blank -%}
            <img
              src="{{ block.settings.avatar_url }}"
              alt="{{ block.settings.author }}"
              class="evora-testimonial-card__avatar"
              loading="lazy"
              width="64"
              height="64"
            >
          {%- endif -%}

          <div class="evora-testimonial-card__stars">★★★★★</div>
          
          <div class="evora-testimonial-card__quote">
            "{{ block.settings.quote }}"
          </div>

          <div class="evora-testimonial-card__author">
            — {{ block.settings.author }}
          </div>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Evora Testimonials",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Loved by Thousands of Women"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Our community is growing stronger every day."
    }
  ],
  "blocks": [
    {
      "type": "testimonial",
      "name": "Testimonial Card",
      "settings": [
        {
          "type": "image_picker",
          "id": "avatar",
          "label": "Author Avatar"
        },
        {
          "type": "text",
          "id": "avatar_url",
          "label": "Fallback Avatar URL"
        },
        {
          "type": "textarea",
          "id": "quote",
          "label": "Quote",
          "default": "Evora has helped me understand my body so much better."
        },
        {
          "type": "text",
          "id": "author",
          "label": "Author Name",
          "default": "Emily R."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Evora Testimonials",
      "blocks": [
        {
          "type": "testimonial",
          "settings": {
            "avatar_url": "https://images.unsplash.com/photo-1534528741775-53994a69daeb?w=120&h=120&fit=crop&crop=face",
            "quote": "Evora has helped me understand my body so much better.",
            "author": "Emily R."
          }
        },
        {
          "type": "testimonial",
          "settings": {
            "avatar_url": "https://images.unsplash.com/photo-1517841905240-472988babdf9?w=120&h=120&fit=crop&crop=face",
            "quote": "The insights are so accurate and the app is beautiful!",
            "author": "Sarah J."
          }
        },
        {
          "type": "testimonial",
          "settings": {
            "avatar_url": "https://images.unsplash.com/photo-1544005313-94ddf0286df2?w=120&h=120&fit=crop&crop=face",
            "quote": "I feel more in control and confident every cycle.",
            "author": "Priya M."
          }
        }
      ]
    }
  ]
}
{% endschema %}
