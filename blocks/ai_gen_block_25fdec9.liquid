{% doc %}
  @prompt
    Create a hero CTA section matching this design: pink/rose gradient background, large bold headline with mixed black and pink text colors (e.g. "Your Wellness, All in One" with accent word in pink), subtitle text below, two CTA buttons side by side (one solid pink filled, one outlined ghost style with arrow), a 3D product logo image on the left, a phone mockup screenshot on the right, and a row of 4 feature icons with short titles and descriptions at the bottom. Overall aesthetic is soft, feminine, wellness-focused with a light pink palette.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
.ai-hero-cta-{{ ai_gen_id }}{
  position: relative;
  overflow: hidden;
  padding:
    {{ block.settings.section_padding_top }}px
    {{ block.settings.section_padding_horizontal }}px
    {{ block.settings.section_padding_bottom }}px;

  background-repeat:no-repeat;
  background-size:cover;
  background-position:center center;
}

  .ai-hero-cta-container-{{ ai_gen_id }} {
    max-width: {{ block.settings.container_max_width }}px;
    margin: 0 auto;
  }

  .ai-hero-cta-main-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: auto 1fr auto;
    gap: {{ block.settings.content_gap }}px;
    align-items: center;
    margin-bottom: {{ block.settings.features_spacing }}px;
  }

  .ai-hero-cta-logo-{{ ai_gen_id }} {
    width: {{ block.settings.logo_width }}px;
    height: auto;
  }

  .ai-hero-cta-logo-{{ ai_gen_id }} img {
    width: 100%;
    height: auto;
    display: block;
  }

  .ai-hero-cta-logo-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: {{ block.settings.logo_width }}px;
    background-color: rgba(255, 91, 130, 0.1);
    border-radius: 16px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-hero-cta-logo-placeholder-{{ ai_gen_id }} svg {
    width: 60%;
    height: 60%;
    opacity: 0.3;
  }

  .ai-hero-cta-content-{{ ai_gen_id }} {
    text-align: {{ block.settings.text_alignment }};
  }

  .ai-hero-cta-headline-{{ ai_gen_id }} {
    font-size: {{ block.settings.headline_size }}px;
    font-weight: {{ block.settings.headline_weight }};
    line-height: 1.1;
    margin: 0 0 {{ block.settings.headline_spacing }}px;
    color: {{ block.settings.headline_color }};
  }

  .ai-hero-cta-headline-{{ ai_gen_id }} .accent {
    color: {{ block.settings.headline_accent_color }};
  }

  .ai-hero-cta-subtitle-{{ ai_gen_id }} {
    font-size: {{ block.settings.subtitle_size }}px;
    line-height: 1.5;
    margin: 0 0 {{ block.settings.subtitle_spacing }}px;
    color: {{ block.settings.subtitle_color }};
    max-width: {{ block.settings.subtitle_max_width }}px;
    {% if block.settings.text_alignment == 'center' %}
      margin-left: auto;
      margin-right: auto;
    {% endif %}
  }
style="{% if section.settings.background_image %}background-image: url('{{ section.settings.background_image | image_url: width: 1920 }}'); background-size: cover; background-position: center;{% endif %}"

  .ai-hero-cta-buttons-{{ ai_gen_id }} {
    display: flex;
    gap: {{ block.settings.button_gap }}px;
    {% if block.settings.text_alignment == 'center' %}
      justify-content: center;
    {% elsif block.settings.text_alignment == 'right' %}
      justify-content: flex-end;
    {% else %}
      justify-content: flex-start;
    {% endif %}
    flex-wrap: wrap;
  }

  .ai-hero-cta-button-{{ ai_gen_id }} {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: {{ block.settings.button_padding_vertical }}px {{ block.settings.button_padding_horizontal }}px;
    font-size: {{ block.settings.button_font_size }}px;
    font-weight: {{ block.settings.button_font_weight }};
    text-decoration: none;
    border-radius: {{ block.settings.button_border_radius }}px;
    transition: all 0.3s ease;
    cursor: pointer;
    border: 2px solid transparent;
  }

  .ai-hero-cta-button-primary-{{ ai_gen_id }} {
    background-color: {{ block.settings.primary_button_bg }};
    color: {{ block.settings.primary_button_color }};
    border-color: {{ block.settings.primary_button_bg }};
  }

  .ai-hero-cta-button-primary-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.primary_button_hover_bg }};
    border-color: {{ block.settings.primary_button_hover_bg }};
    transform: translateY(-2px);
  }

  .ai-hero-cta-button-secondary-{{ ai_gen_id }} {
    background-color: transparent;
    color: {{ block.settings.secondary_button_color }};
    border-color: {{ block.settings.secondary_button_border }};
  }

  .ai-hero-cta-button-secondary-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.secondary_button_hover_bg }};
    border-color: {{ block.settings.secondary_button_hover_border }};
    transform: translateY(-2px);
  }

  .ai-hero-cta-button-arrow-{{ ai_gen_id }} {
    width: 16px;
    height: 16px;
    transition: transform 0.3s ease;
  }

  .ai-hero-cta-button-{{ ai_gen_id }}:hover .ai-hero-cta-button-arrow-{{ ai_gen_id }} {
    transform: translateX(4px);
  }

  .ai-hero-cta-phone-{{ ai_gen_id }} {
    width: {{ block.settings.phone_width }}px;
    height: auto;
  }

  .ai-hero-cta-phone-{{ ai_gen_id }} img {
    width: 100%;
    height: auto;
    display: block;
    border-radius: {{ block.settings.phone_border_radius }}px;
  }

  .ai-hero-cta-phone-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: {{ block.settings.phone_width | times: 1.8 }}px;
    background-color: rgba(255, 91, 130, 0.1);
    border-radius: {{ block.settings.phone_border_radius }}px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-hero-cta-phone-placeholder-{{ ai_gen_id }} svg {
    width: 50%;
    height: 50%;
    opacity: 0.3;
  }

  .ai-hero-cta-features-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat({{ block.settings.features_columns }}, 1fr);
    gap: {{ block.settings.features_gap }}px;
  }

  .ai-hero-cta-feature-{{ ai_gen_id }} {
    text-align: center;
  }

  .ai-hero-cta-feature-icon-{{ ai_gen_id }} {
    width: {{ block.settings.feature_icon_size }}px;
    height: {{ block.settings.feature_icon_size }}px;
    margin: 0 auto {{ block.settings.feature_icon_spacing }}px;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: {{ block.settings.feature_icon_bg }};
    border-radius: {{ block.settings.feature_icon_radius }}px;
  }

  .ai-hero-cta-feature-icon-{{ ai_gen_id }} img {
    width: 60%;
    height: 60%;
    object-fit: contain;
  }

  .ai-hero-cta-feature-icon-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-hero-cta-feature-icon-placeholder-{{ ai_gen_id }} svg {
    width: 60%;
    height: 60%;
    opacity: 0.4;
  }

  .ai-hero-cta-feature-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.feature_title_size }}px;
    font-weight: {{ block.settings.feature_title_weight }};
    margin: 0 0 {{ block.settings.feature_title_spacing }}px;
    color: {{ block.settings.feature_title_color }};
  }

  .ai-hero-cta-feature-description-{{ ai_gen_id }} {
    font-size: {{ block.settings.feature_description_size }}px;
    line-height: 1.5;
    margin: 0;
    color: {{ block.settings.feature_description_color }};
  }

  @media screen and (max-width: 989px) {
    .ai-hero-cta-main-{{ ai_gen_id }} {
      grid-template-columns: 1fr;
      gap: 40px;
    }

    .ai-hero-cta-logo-{{ ai_gen_id }},
    .ai-hero-cta-phone-{{ ai_gen_id }} {
      margin: 0 auto;
    }

    .ai-hero-cta-content-{{ ai_gen_id }} {
      text-align: center;
    }

    .ai-hero-cta-buttons-{{ ai_gen_id }} {
      justify-content: center;
    }

    .ai-hero-cta-subtitle-{{ ai_gen_id }} {
      margin-left: auto;
      margin-right: auto;
    }

    .ai-hero-cta-features-{{ ai_gen_id }} {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media screen and (max-width: 749px) {
    .ai-hero-cta-{{ ai_gen_id }} {
      padding: {{ block.settings.section_padding_top | times: 0.6 }}px {{ block.settings.section_padding_horizontal | times: 0.6 }}px {{ block.settings.section_padding_bottom | times: 0.6 }}px;
    }

    .ai-hero-cta-headline-{{ ai_gen_id }} {
      font-size: {{ block.settings.headline_size | times: 0.6 }}px;
    }

    .ai-hero-cta-subtitle-{{ ai_gen_id }} {
      font-size: {{ block.settings.subtitle_size | times: 0.9 }}px;
    }

    .ai-hero-cta-features-{{ ai_gen_id }} {
      grid-template-columns: 1fr;
    }

    .ai-hero-cta-logo-{{ ai_gen_id }} {
      width: {{ block.settings.logo_width | times: 0.7 }}px;
    }

    .ai-hero-cta-phone-{{ ai_gen_id }} {
      width: {{ block.settings.phone_width | times: 0.7 }}px;
    }
  }
{% endstyle %}

<hero-cta-{{ ai_gen_id }}
class="ai-hero-cta-{{ ai_gen_id }}"
{% if block.settings.background_image %}
style="
background-image:url('{{ block.settings.background_image | image_url: width: 2200 }}');
"
{% endif %}
{{ block.shopify_attributes }}>
  <div class="ai-hero-cta-container-{{ ai_gen_id }}">
    <div class="ai-hero-cta-main-{{ ai_gen_id }}">
      <div class="ai-hero-cta-logo-{{ ai_gen_id }}">
        {% if block.settings.logo_image %}
          <img
            src="{{ block.settings.logo_image | image_url: width: 400 }}"
            alt="{{ block.settings.logo_image.alt | escape }}"
            loading="lazy"
            width="{{ block.settings.logo_image.width }}"
            height="{{ block.settings.logo_image.height }}"
          >
        {% else %}
          <div class="ai-hero-cta-logo-placeholder-{{ ai_gen_id }}">
            {{ 'product-1' | placeholder_svg_tag }}
          </div>
        {% endif %}
      </div>

      <div class="ai-hero-cta-content-{{ ai_gen_id }}">
        {% if block.settings.headline != blank %}
          <h1 class="ai-hero-cta-headline-{{ ai_gen_id }}">
            {{ block.settings.headline }}
          </h1>
        {% endif %}

        {% if block.settings.subtitle != blank %}
          <div class="ai-hero-cta-subtitle-{{ ai_gen_id }}">
            {{ block.settings.subtitle }}
          </div>
        {% endif %}

        <div class="ai-hero-cta-buttons-{{ ai_gen_id }}">
          {% if block.settings.primary_button_label != blank %}
            <a
              href="{{ block.settings.primary_button_link }}"
              class="ai-hero-cta-button-{{ ai_gen_id }} ai-hero-cta-button-primary-{{ ai_gen_id }}"
            >
              {{ block.settings.primary_button_label }}
            </a>
          {% endif %}

          {% if block.settings.secondary_button_label != blank %}
            <a
              href="{{ block.settings.secondary_button_link }}"
              class="ai-hero-cta-button-{{ ai_gen_id }} ai-hero-cta-button-secondary-{{ ai_gen_id }}"
            >
              {{ block.settings.secondary_button_label }}
              <svg class="ai-hero-cta-button-arrow-{{ ai_gen_id }}" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M1 8H15M15 8L8 1M15 8L8 15" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </a>
          {% endif %}
        </div>
      </div>

      <div class="ai-hero-cta-phone-{{ ai_gen_id }}">
        {% if block.settings.phone_image %}
          <img
            src="{{ block.settings.phone_image | image_url: width: 600 }}"
            alt="{{ block.settings.phone_image.alt | escape }}"
            loading="lazy"
            width="{{ block.settings.phone_image.width }}"
            height="{{ block.settings.phone_image.height }}"
          >
        {% else %}
          <div class="ai-hero-cta-phone-placeholder-{{ ai_gen_id }}">
            {{ 'image' | placeholder_svg_tag }}
          </div>
        {% endif %}
      </div>
    </div>

    <div class="ai-hero-cta-features-{{ ai_gen_id }}">
      {% for i in (1..4) %}
        {% liquid
          assign feature_icon_key = 'feature_' | append: i | append: '_icon'
          assign feature_title_key = 'feature_' | append: i | append: '_title'
          assign feature_description_key = 'feature_' | append: i | append: '_description'
          
          assign feature_icon = block.settings[feature_icon_key]
          assign feature_title = block.settings[feature_title_key]
          assign feature_description = block.settings[feature_description_key]
        %}

        <div class="ai-hero-cta-feature-{{ ai_gen_id }}">
          <div class="ai-hero-cta-feature-icon-{{ ai_gen_id }}">
            {% if feature_icon %}
              <img
                src="{{ feature_icon | image_url: width: 200 }}"
                alt="{{ feature_icon.alt | escape }}"
                loading="lazy"
                width="{{ feature_icon.width }}"
                height="{{ feature_icon.height }}"
              >
            {% else %}
              <div class="ai-hero-cta-feature-icon-placeholder-{{ ai_gen_id }}">
                {{ 'image' | placeholder_svg_tag }}
              </div>
            {% endif %}
          </div>

          {% if feature_title != blank %}
            <h3 class="ai-hero-cta-feature-title-{{ ai_gen_id }}">{{ feature_title }}</h3>
          {% endif %}

          {% if feature_description != blank %}
            <p class="ai-hero-cta-feature-description-{{ ai_gen_id }}">{{ feature_description }}</p>
          {% endif %}
        </div>
      {% endfor %}
    </div>
  </div>
</hero-cta-{{ ai_gen_id }}>

<script>
  (function() {
    class HeroCta{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.setupAccessibility();
      }

      setupAccessibility() {
        const buttons = this.querySelectorAll('.ai-hero-cta-button-{{ ai_gen_id }}');
        buttons.forEach(button => {
          if (!button.getAttribute('href') || button.getAttribute('href') === '') {
            button.setAttribute('role', 'button');
            button.setAttribute('tabindex', '0');
          }
        });
      }
    }

    customElements.define('hero-cta-{{ ai_gen_id }}', HeroCta{{ ai_gen_id }});
  })();
</script>

