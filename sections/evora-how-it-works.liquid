{{ 'evora-base.css' | asset_url | stylesheet_tag }}
{{ 'evora-components.css' | asset_url | stylesheet_tag }}

<section
  id="EvoraHowItWorks-{{ section.id }}"
  class="evora-section-padding evora-bg-surface"
  data-section-id="{{ section.id }}"
>
  <div class="evora-container">
    <div class="evora-section-header">
      <h2 class="evora-section-header__title evora-serif">
        {{ section.settings.heading | default: 'How does it work?' }}
      </h2>
    </div>

    <div class="evora-steps-grid">
      {%- for block in section.blocks -%}
        <div class="evora-step-card" {{ block.shopify_attributes }}>
          <div class="evora-step-card__header">
            <div class="evora-step-card__num">{{ forloop.index }}</div>
            <div class="evora-step-card__title">{{ block.settings.title }}</div>
          </div>

          <div class="evora-step-card__media">
            {%- if block.settings.image != blank -%}
              {{ block.settings.image | image_url: width: 600 | image_tag:
                loading: 'lazy',
                alt: block.settings.title
              }}
            {%- elsif block.settings.image_url != blank -%}
              <img
                src="{{ block.settings.image_url }}"
                alt="{{ block.settings.title }}"
                loading="lazy"
                width="400"
                height="220"
              >
            {%- else -%}
              <div style="width: 100%; height: 100%; display: flex; align-items: center; justify-content: center; background: #FFF0F3; font-size: 3.5rem;">
                {%- case forloop.index -%}
                  {%- when 1 -%}📱
                  {%- when 2 -%}🛏️
                  {%- when 3 -%}🏃‍♀️
                {%- endcase -%}
              </div>
            {%- endif -%}
          </div>

          <div class="evora-step-card__body">
            {{ block.settings.description }}
          </div>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Evora How It Works",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "How does it work?"
    }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Process Step",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Step Title",
          "default": "Set up your alarm"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Step Image"
        },
        {
          "type": "text",
          "id": "image_url",
          "label": "Fallback Image URL"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Step Description",
          "default": "Open the Flow App and create your first alarm. Takes only 10 seconds."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Evora How It Works",
      "blocks": [
        {
          "type": "step",
          "settings": {
            "title": "Set up your alarm",
            "image_url": "https://images.unsplash.com/photo-1512941937669-90a1b58e7e9c?w=600&h=350&fit=crop",
            "description": "Open the Flow App and create your first alarm. Takes only 10 seconds."
          }
        },
        {
          "type": "step",
          "settings": {
            "title": "Place it across the room",
            "image_url": "https://images.unsplash.com/photo-1540518614846-7ede433c4ef2?w=600&h=350&fit=crop",
            "description": "Put your Flow Dock on your nightstand or across the room."
          }
        },
        {
          "type": "step",
          "settings": {
            "title": "Get up to dismiss",
            "image_url": "https://images.unsplash.com/photo-1519085360753-af0119f7cbe7?w=600&h=350&fit=crop",
            "description": "When the alarm goes off, you must get up and dismiss it on the Dock."
          }
        }
      ]
    }
  ]
}
{% endschema %}
