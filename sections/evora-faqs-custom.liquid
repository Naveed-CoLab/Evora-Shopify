      "default": "#E7EBEF"
    },
    {
      "type": "range",
      "id": "card_padding_vertical",
      "label": "Row padding (top & bottom)",
      "min": 10,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 22
    },
    {
      "type": "header",
      "content": "Section spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
