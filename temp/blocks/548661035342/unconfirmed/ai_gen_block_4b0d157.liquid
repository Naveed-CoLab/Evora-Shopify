{% doc %}
  @prompt
    Create a CTA section with a pink background. On the left side: a heading (e.g. "Stay in the Loop" with a heart emoji), a short description text below it, and an email input field with a pink "Subscribe" button next to it. On the right side: a phone/app mockup image that the merchant can change via theme settings. The section should have rounded corners, good padding, and the two columns should be vertically centred. The image on the right should be configurable so the merchant can swap it out easily.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-cta-subscribe-{{ ai_gen_id }} {
    display: block;
    width: 100%;
  }

  .ai-cta-subscribe-container-{{ ai_gen_id }} {
    background-color: {{ block.settings.background_color }};
    border-radius: {{ block.settings.border_radius }}px;
    padding: {{ block.settings.padding_vertical }}px {{ block.settings.padding_horizontal }}px;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    margin: 0 auto;
  }

  .ai-cta-subscribe-grid-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: {{ block.settings.column_gap }}px;
    align-items: center;
  }

  .ai-cta-subscribe-content-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: {{ block.settings.content_gap }}px;
  }

  .ai-cta-subscribe-heading-{{ ai_gen_id }} {
    color: {{ block.settings.heading_color }};
    font-size: {{ block.settings.heading_size }}px;
    margin: 0;
    line-height: 1.2;
  }

  .ai-cta-subscribe-description-{{ ai_gen_id }} {
    color: {{ block.settings.text_color }};
    font-size: {{ block.settings.text_size }}px;
    line-height: 1.5;
    margin: 0;
  }

  .ai-cta-subscribe-form-wrapper-{{ ai_gen_id }} {
    width: 100%;
  }

  .ai-cta-subscribe-form-field-{{ ai_gen_id }} {
    display: flex;
    gap: 8px;
    width: 100%;
  }

  .ai-cta-subscribe-input-{{ ai_gen_id }} {
    flex-grow: 1;
    padding: 14px 18px;
    border: 1px solid {{ block.settings.input_border_color }};
    border-radius: {{ block.settings.input_border_radius }}px;
    background-color: {{ block.settings.input_background_color }};
    color: {{ block.settings.input_text_color }};
    font-size: 16px;
  }

  .ai-cta-subscribe-input-{{ ai_gen_id }}::placeholder {
    color: {{ block.settings.input_placeholder_color }};
  }

  .ai-cta-subscribe-button-{{ ai_gen_id }} {
    padding: 14px 28px;
    background-color: {{ block.settings.button_color }};
    color: {{ block.settings.button_text_color }};
    border: none;
    border-radius: {{ block.settings.button_border_radius }}px;
    cursor: pointer;
    font-size: 16px;
    font-weight: 600;
    white-space: nowrap;
    transition: background-color 0.3s ease;
  }

  .ai-cta-subscribe-button-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_hover_color }};
  }

  .ai-cta-subscribe-image-wrapper-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
  }

  .ai-cta-subscribe-image-{{ ai_gen_id }} {
    width: 100%;
    height: auto;
    max-width: {{ block.settings.image_max_width }}px;
    border-radius: {{ block.settings.image_border_radius }}px;
  }

  .ai-cta-subscribe-image-placeholder-{{ ai_gen_id }} {
    width: 100%;
    max-width: {{ block.settings.image_max_width }}px;
    aspect-ratio: 1 / 1.2;
    background-color: rgba(255, 255, 255, 0.3);
    border-radius: {{ block.settings.image_border_radius }}px;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
  }

  .ai-cta-subscribe-image-placeholder-{{ ai_gen_id }} svg {
    width: 60%;
    height: 60%;
    opacity: 0.4;
  }

  .ai-cta-subscribe-empty-state-{{ ai_gen_id }} {
    position: absolute;
    bottom: 20px;
    left: 50%;
    transform: translateX(-50%);
    padding: 8px 16px;
    font-size: 13px;
    color: rgba(36, 34, 42, 0.6);
    text-align: center;
    pointer-events: none;
  }

  .ai-cta-subscribe-success-{{ ai_gen_id }} {
    color: {{ block.settings.success_color }};
    margin-top: 8px;
    font-size: 14px;
  }

  .ai-cta-subscribe-error-{{ ai_gen_id }} {
    color: {{ block.settings.error_color }};
    margin-top: 8px;
    font-size: 14px;
  }

  @media screen and (max-width: 749px) {
    .ai-cta-subscribe-grid-{{ ai_gen_id }} {
      grid-template-columns: 1fr;
      gap: {{ block.settings.mobile_gap }}px;
    }

    .ai-cta-subscribe-container-{{ ai_gen_id }} {
      padding: {{ block.settings.mobile_padding_vertical }}px {{ block.settings.mobile_padding_horizontal }}px;
    }

    .ai-cta-subscribe-heading-{{ ai_gen_id }} {
      font-size: {{ block.settings.heading_size | times: 0.8 }}px;
    }

    .ai-cta-subscribe-description-{{ ai_gen_id }} {
      font-size: {{ block.settings.text_size | times: 0.9 }}px;
    }

    .ai-cta-subscribe-form-field-{{ ai_gen_id }} {
      flex-direction: column;
    }

    .ai-cta-subscribe-button-{{ ai_gen_id }} {
      width: 100%;
    }
  }
{% endstyle %}

<cta-subscribe-{{ ai_gen_id }} class="ai-cta-subscribe-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-cta-subscribe-container-{{ ai_gen_id }}">
    <div class="ai-cta-subscribe-grid-{{ ai_gen_id }}">
      <div class="ai-cta-subscribe-content-{{ ai_gen_id }}">
        {% if block.settings.heading != blank %}
          <h2 class="ai-cta-subscribe-heading-{{ ai_gen_id }}">{{ block.settings.heading }}</h2>
        {% endif %}

        {% if block.settings.description != blank %}
          <div class="ai-cta-subscribe-description-{{ ai_gen_id }}">{{ block.settings.description }}</div>
        {% endif %}

        <div class="ai-cta-subscribe-form-wrapper-{{ ai_gen_id }}">
          {%- form 'contact' -%}
            <input type="hidden" name="contact[tags]" value="newsletter">
            <div class="ai-cta-subscribe-form-field-{{ ai_gen_id }}">
              <input
                type="email"
                name="contact[email]"
                class="ai-cta-subscribe-input-{{ ai_gen_id }}"
                value="{{ form.email }}"
                aria-required="true"
                autocorrect="off"
                autocapitalize="off"
                autocomplete="email"
                {% if form.errors %}
                  aria-invalid="true"
                  aria-describedby="ai-cta-subscribe-error-{{ ai_gen_id }}"
                {% endif %}
                {% if form.posted_successfully? %}
                  aria-describedby="ai-cta-subscribe-success-{{ ai_gen_id }}"
                {% endif %}
                placeholder="{{ block.settings.email_placeholder }}"
                required
              >
              <button type="submit" class="ai-cta-subscribe-button-{{ ai_gen_id }}">
                {{ block.settings.button_text }}
              </button>
            </div>
            {%- if form.errors -%}
              <div id="ai-cta-subscribe-error-{{ ai_gen_id }}" class="ai-cta-subscribe-error-{{ ai_gen_id }}">
                <span>{{ form.errors.messages.email }}</span>
              </div>
            {%- endif -%}
            {%- if form.posted_successfully? -%}
              <div id="ai-cta-subscribe-success-{{ ai_gen_id }}" class="ai-cta-subscribe-success-{{ ai_gen_id }}">
                <span>{{ block.settings.success_message }}</span>
              </div>
            {%- endif -%}
          {%- endform -%}
        </div>
      </div>

      <div class="ai-cta-subscribe-image-wrapper-{{ ai_gen_id }}">
        {% if block.settings.image %}
          <img
            src="{{ block.settings.image | image_url: width: 800 }}"
            alt="{{ block.settings.image.alt | escape }}"
            loading="lazy"
            width="{{ block.settings.image.width }}"
            height="{{ block.settings.image.height }}"
            class="ai-cta-subscribe-image-{{ ai_gen_id }}"
          >
        {% else %}
          <div class="ai-cta-subscribe-image-placeholder-{{ ai_gen_id }}">
            {{ 'image' | placeholder_svg_tag }}
            <div class="ai-cta-subscribe-empty-state-{{ ai_gen_id }}">
              Next, add an image
            </div>
          </div>
        {% endif %}
      </div>
    </div>
  </div>
</cta-subscribe-{{ ai_gen_id }}>

<script>
  (function() {
    class CtaSubscribe{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.form = this.querySelector('form');
        if (this.form) {
          this.setupFormValidation();
        }
      }

      setupFormValidation() {
        const emailInput = this.form.querySelector('input[type="email"]');
        if (emailInput) {
          emailInput.addEventListener('invalid', function(e) {
            e.preventDefault();
            emailInput.setAttribute('aria-invalid', 'true');
          });

          emailInput.addEventListener('input', function() {
            if (emailInput.validity.valid) {
              emailInput.removeAttribute('aria-invalid');
            }
          });
        }
      }
    }

    customElements.define('cta-subscribe-{{ ai_gen_id }}', CtaSubscribe{{ ai_gen_id }});
  })();
</script>

