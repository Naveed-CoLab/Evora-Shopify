{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-footer-{{ ai_gen_id }} {
    display: block;
    background-color: {{ block.settings.background_color }};
    color: {{ block.settings.text_color }};
    padding: {{ block.settings.padding_top }}px 0 0;
    width: 100%;
  }

  .ai-footer-container-{{ ai_gen_id }} {
    max-width: {{ block.settings.container_width }}px;
    margin: 0 auto;
    padding: 0 {{ block.settings.horizontal_padding }}px;
  }

  .ai-footer-main-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: 1fr 2fr;
    gap: {{ block.settings.column_gap }}px;
    padding-bottom: {{ block.settings.main_padding_bottom }}px;
    border-bottom: 1px solid {{ block.settings.border_color }};
  }

  .ai-footer-left-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: {{ block.settings.left_column_gap }}px;
  }

  .ai-footer-logo-{{ ai_gen_id }} {
    width: {{ block.settings.logo_width }}px;
    height: auto;
  }

  .ai-footer-logo-placeholder-{{ ai_gen_id }} {
    width: {{ block.settings.logo_width }}px;
    height: 60px;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 4px;
  }

  .ai-footer-logo-placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .ai-footer-tagline-{{ ai_gen_id }} {
    font-size: {{ block.settings.tagline_size }}px;
    line-height: 1.5;
    color: {{ block.settings.text_color }};
    margin: 0;
  }

  .ai-footer-app-badges-{{ ai_gen_id }} {
    display: flex;
    gap: 12px;
    align-items: center;
  }

  .ai-footer-app-badge-{{ ai_gen_id }} {
    display: inline-block;
    transition: opacity 0.2s ease;
  }

  .ai-footer-app-badge-{{ ai_gen_id }}:hover {
    opacity: 0.8;
  }

  .ai-footer-app-badge-{{ ai_gen_id }} svg {
    height: {{ block.settings.badge_height }}px;
    width: auto;
  }

  .ai-footer-right-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: {{ block.settings.nav_column_gap }}px;
  }

  .ai-footer-nav-column-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: {{ block.settings.nav_link_gap }}px;
  }

  .ai-footer-nav-heading-{{ ai_gen_id }} {
    font-size: {{ block.settings.heading_size }}px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    margin: 0 0 {{ block.settings.heading_margin_bottom }}px;
    color: {{ block.settings.heading_color }};
  }
  .ai-footer-socials-{{ ai_gen_id }} {
  display: flex;
  align-items: center;
  gap: 16px;
}

.ai-footer-social-{{ ai_gen_id }} {
  display: flex !important;
  align-items: center;
  justify-content: center;
  width: 22px !important;
  height: 22px !important;
  padding: 0 !important;
  margin: 0 !important;
  color: #000000 !important;
  text-decoration: none !important;
  line-height: 0 !important;
  background: transparent !important;
  border: 0 !important;
  box-shadow: none !important;
}

.ai-footer-social-{{ ai_gen_id }}:hover {
  color: #000000 !important;
  opacity: 0.65;
}

.ai-footer-social-icon-{{ ai_gen_id }} {
  display: block !important;
  width: 22px !important;
  height: 22px !important;
  min-width: 22px !important;
  min-height: 22px !important;
  max-width: 22px !important;
  max-height: 22px !important;
  fill: #000000 !important;
  color: #000000 !important;
  stroke: none !important;
  margin: 0 !important;
  padding: 0 !important;
}

.ai-footer-social-icon-{{ ai_gen_id }} path {
  fill: #000000 !important;
  color: #000000 !important;
  stroke: none !important;
}

  .ai-footer-nav-link-{{ ai_gen_id }} {
    font-size: {{ block.settings.link_size }}px;
    color: {{ block.settings.link_color }};
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .ai-footer-nav-link-{{ ai_gen_id }}:hover {
    color: {{ block.settings.link_hover_color }};
  }

  .ai-footer-bottom-{{ ai_gen_id }} {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: {{ block.settings.bottom_padding_vertical }}px 0;
  }

.ai-footer-copyright-{{ ai_gen_id }} + div a:hover svg {
  opacity: 1;
}


  @media screen and (max-width: 749px) {
    .ai-footer-main-{{ ai_gen_id }} {
      grid-template-columns: 1fr;
      gap: {{ block.settings.mobile_section_gap }}px;
    }

    .ai-footer-right-{{ ai_gen_id }} {
      grid-template-columns: 1fr;
      gap: {{ block.settings.mobile_nav_gap }}px;
    }

    .ai-footer-bottom-{{ ai_gen_id }} {
      flex-direction: column;
      gap: 20px;
      text-align: center;
    }

    .ai-footer-app-badges-{{ ai_gen_id }} {
      flex-wrap: wrap;
    }
  }
{% endstyle %}

<footer-custom-{{ ai_gen_id }} class="ai-footer-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-footer-container-{{ ai_gen_id }}">
    <div class="ai-footer-main-{{ ai_gen_id }}">
      <div class="ai-footer-left-{{ ai_gen_id }}">
        {% if block.settings.logo %}
          <img
            src="{{ block.settings.logo | image_url: width: 400 }}"
            alt="{{ block.settings.logo.alt | escape }}"
            class="ai-footer-logo-{{ ai_gen_id }}"
            loading="lazy"
            width="{{ block.settings.logo.width }}"
            height="{{ block.settings.logo.height }}"
          >
        {% else %}
          <div class="ai-footer-logo-placeholder-{{ ai_gen_id }}">
            {{ 'image' | placeholder_svg_tag }}
          </div>
        {% endif %}

        {% if block.settings.tagline != blank %}
          <p class="ai-footer-tagline-{{ ai_gen_id }}">{{ block.settings.tagline }}</p>
        {% endif %}

        <div class="ai-footer-app-badges-{{ ai_gen_id }}">
          {% if block.settings.apple_store_url != blank %}
            <a
              href="{{ block.settings.apple_store_url }}"
              class="ai-footer-app-badge-{{ ai_gen_id }}"
              target="_blank"
              rel="noopener"
              aria-label="Download on the App Store"
            >
              <svg viewBox="0 0 120 40" xmlns="http://www.w3.org/2000/svg">
                <rect width="120" height="40" rx="5" fill="#000000"/>
                <path d="M24.769 20.301c-.024-2.555 2.087-3.787 2.182-3.848-1.189-1.739-3.042-1.977-3.701-2.003-1.575-.16-3.074.928-3.872.928-.798 0-2.031-.904-3.338-.88-1.717.025-3.298 1-4.185 2.54-1.784 3.094-.456 7.677 1.282 10.186.85 1.229 1.862 2.608 3.193 2.559 1.283-.05 1.768-.83 3.318-.83 1.55 0 1.987.83 3.337.804 1.377-.024 2.252-1.245 3.095-2.479.975-1.428 1.376-2.81 1.4-2.883-.03-.014-2.686-1.031-2.711-4.094z" fill="#ffffff"/>
